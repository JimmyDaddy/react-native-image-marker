<script>
  type PlaygroundMode = 'text' | 'image' | 'mixed';
  type LayoutMode = 'single' | 'tile';
  type CodeTarget = 'web' | 'native';
  type WorkspaceTab = 'visible' | 'batch' | 'invisible';
  type MarkerSdk = typeof import('../../../src/index');
  type PositionEnum = MarkerSdk['Position'];

  interface PlaygroundState {
    mode: PlaygroundMode;
    textLayout: LayoutMode;
    imageLayout: LayoutMode;
    backgroundSrc: string;
    logoSrc: string;
    result: string;
    codeTarget: CodeTarget;
    workspace: WorkspaceTab;
    renderSequence: number;
  }

  const MAX_FILE_BYTES = 12 * 1024 * 1024;
  const MAX_IMAGE_PIXELS = 16_000_000;

  const sdkPromise = import('../../../src/index');

  const asElement = <T extends Element>(root: ParentNode, selector: string): T => {
    const element = root.querySelector<T>(selector);
    if (!element) throw new Error(`Missing playground element: ${selector}`);
    return element;
  };

  const numberValue = (input: HTMLInputElement) => Number(input.value);

  const layoutValue = (input: HTMLInputElement): number | string => {
    const value = input.value.trim();
    return value.endsWith('%') ? value : Number(value);
  };

  const readFileAsDataUrl = (file?: File): Promise<string> =>
    new Promise((resolve, reject) => {
      if (!file) {
        reject(new Error('No file selected'));
        return;
      }
      const reader = new FileReader();
      reader.addEventListener('load', () => resolve(String(reader.result)));
      reader.addEventListener('error', () => reject(reader.error ?? new Error('File read failed')));
      reader.readAsDataURL(file);
    });

  const copyText = async (value: string): Promise<void> => {
    if (!navigator.clipboard?.writeText) throw new Error('Clipboard API unavailable');
    await navigator.clipboard.writeText(value);
  };

  const imageDimensions = (src: string): Promise<{ width: number; height: number }> =>
    new Promise((resolve, reject) => {
      const image = new Image();
      image.addEventListener('load', () =>
        resolve({ width: image.naturalWidth, height: image.naturalHeight })
      );
      image.addEventListener('error', () => reject(new Error('Output image failed to load')));
      image.src = src;
    });

  document.querySelectorAll<HTMLElement>('[data-marker-playground]').forEach((root) => {
    if (root.dataset.initialized === 'true') return;
    root.dataset.initialized = 'true';

    const defaultBackground = root.dataset.backgroundUrl ?? '';
    const defaultLogo = root.dataset.logoUrl ?? '';
    const state: PlaygroundState = {
      mode: 'mixed',
      textLayout: 'single',
      imageLayout: 'single',
      backgroundSrc: defaultBackground,
      logoSrc: defaultLogo,
      result: '',
      codeTarget: 'web',
      workspace: 'visible',
      renderSequence: 0,
    };

    const workspaceTabs = [
      ...root.querySelectorAll<HTMLButtonElement>('[data-workspace-tab]'),
    ];
    const workspacePanels = [
      ...root.querySelectorAll<HTMLElement>('[data-workspace-panel]'),
    ];
    const previewFrame = asElement<HTMLElement>(root, '[data-preview-frame]');
    const preview = asElement<HTMLImageElement>(root, '[data-preview]');
    const statusText = asElement<HTMLElement>(root, '[data-status-text]');
    const status = asElement<HTMLElement>(root, '[data-render-state]');
    const dimensions = asElement<HTMLElement>(root, '[data-dimensions]');
    const elapsed = asElement<HTMLElement>(root, '[data-elapsed]');
    const resultUri = asElement<HTMLElement>(root, '[data-result-uri]');
    const renderButton = asElement<HTMLButtonElement>(root, '[data-render]');
    const livePreview = asElement<HTMLInputElement>(root, '[data-live-preview]');
    const download = asElement<HTMLAnchorElement>(root, '[data-download]');
    const copyResultButton = asElement<HTMLButtonElement>(root, '[data-copy-result]');
    const backgroundFile = asElement<HTMLInputElement>(root, '[data-background-file]');
    const logoFile = asElement<HTMLInputElement>(root, '[data-logo-file]');
    const textInput = asElement<HTMLInputElement>(root, '[data-text]');
    const colorInput = asElement<HTMLInputElement>(root, '[data-color]');
    const colorValue = asElement<HTMLElement>(root, '[data-color-value]');
    const fontSize = asElement<HTMLInputElement>(root, '[data-font-size]');
    const textOpacity = asElement<HTMLInputElement>(root, '[data-text-opacity]');
    const textBlend = asElement<HTMLSelectElement>(root, '[data-text-blend]');
    const bold = asElement<HTMLInputElement>(root, '[data-bold]');
    const strokeEnabled = asElement<HTMLInputElement>(root, '[data-stroke-enabled]');
    const strokeColor = asElement<HTMLInputElement>(root, '[data-stroke-color]');
    const strokeColorValue = asElement<HTMLElement>(root, '[data-stroke-color-value]');
    const strokeWidth = asElement<HTMLInputElement>(root, '[data-stroke-width]');
    const textRotation = asElement<HTMLInputElement>(root, '[data-text-rotation]');
    const textPosition = asElement<HTMLSelectElement>(root, '[data-text-position]');
    const textX = asElement<HTMLInputElement>(root, '[data-text-x]');
    const textY = asElement<HTMLInputElement>(root, '[data-text-y]');
    const textGapX = asElement<HTMLInputElement>(root, '[data-text-gap-x]');
    const textGapY = asElement<HTMLInputElement>(root, '[data-text-gap-y]');
    const textLayoutX = asElement<HTMLInputElement>(root, '[data-text-layout-x]');
    const textLayoutY = asElement<HTMLInputElement>(root, '[data-text-layout-y]');
    const textStagger = asElement<HTMLInputElement>(root, '[data-text-stagger]');
    const opacity = asElement<HTMLInputElement>(root, '[data-opacity]');
    const scale = asElement<HTMLInputElement>(root, '[data-scale]');
    const imageBlend = asElement<HTMLSelectElement>(root, '[data-image-blend]');
    const imageRotation = asElement<HTMLInputElement>(root, '[data-image-rotation]');
    const imagePosition = asElement<HTMLSelectElement>(root, '[data-image-position]');
    const imageX = asElement<HTMLInputElement>(root, '[data-image-x]');
    const imageY = asElement<HTMLInputElement>(root, '[data-image-y]');
    const imageGapX = asElement<HTMLInputElement>(root, '[data-image-gap-x]');
    const imageGapY = asElement<HTMLInputElement>(root, '[data-image-gap-y]');
    const imageLayoutX = asElement<HTMLInputElement>(root, '[data-image-layout-x]');
    const imageLayoutY = asElement<HTMLInputElement>(root, '[data-image-layout-y]');
    const imageStagger = asElement<HTMLInputElement>(root, '[data-image-stagger]');
    const format = asElement<HTMLSelectElement>(root, '[data-format]');
    const quality = asElement<HTMLInputElement>(root, '[data-quality]');
    const webCode = asElement<HTMLElement>(root, '[data-web-code]');
    const nativeCode = asElement<HTMLElement>(root, '[data-native-code]');
    const batchFiles = asElement<HTMLInputElement>(root, '[data-batch-files]');
    const batchSelection = asElement<HTMLElement>(root, '[data-batch-selection]');
    const batchStatus = asElement<HTMLElement>(root, '[data-batch-status]');
    const batchSummary = asElement<HTMLElement>(root, '[data-batch-summary]');
    const batchProgress = asElement<HTMLElement>(root, '[data-batch-progress]');
    const batchProgressbar = batchProgress.parentElement;
    const batchRun = asElement<HTMLButtonElement>(root, '[data-batch-run]');
    const batchCancel = asElement<HTMLButtonElement>(root, '[data-batch-cancel]');
    const batchResults = asElement<HTMLElement>(root, '[data-batch-results]');
    const invisiblePayload = asElement<HTMLInputElement>(root, '[data-invisible-payload]');
    const invisibleKey = asElement<HTMLInputElement>(root, '[data-invisible-key]');
    const invisibleStrength = asElement<HTMLSelectElement>(root, '[data-invisible-strength]');
    const invisibleTransform = asElement<HTMLSelectElement>(root, '[data-invisible-transform]');
    const invisibleExecutor = asElement<HTMLSelectElement>(root, '[data-invisible-executor]');
    const invisibleStatus = asElement<HTMLElement>(root, '[data-invisible-status]');
    const invisibleEmbed = asElement<HTMLButtonElement>(root, '[data-invisible-embed]');
    const invisibleDetect = asElement<HTMLButtonElement>(root, '[data-invisible-detect]');
    const invisibleCancel = asElement<HTMLButtonElement>(root, '[data-invisible-cancel]');

    const getTextLayer = (Position: PositionEnum) => ({
      text: textInput.value || 'IMAGE MARKER',
      alpha: numberValue(textOpacity),
      blendMode: textBlend.value as 'normal' | 'multiply' | 'screen' | 'overlay' | 'darken' | 'lighten',
      ...(state.textLayout === 'tile'
        ? {
            layout: {
              type: 'tile' as const,
              gapX: layoutValue(textGapX),
              gapY: layoutValue(textGapY),
              offsetX: layoutValue(textLayoutX),
              offsetY: layoutValue(textLayoutY),
              stagger: textStagger.checked,
            },
          }
        : {
            position: {
              position: Position[textPosition.value as keyof PositionEnum],
              X: numberValue(textX),
              Y: numberValue(textY),
            },
          }),
      style: {
        color: colorInput.value.toUpperCase(),
        fontSize: numberValue(fontSize),
        bold: bold.checked,
        rotate: numberValue(textRotation),
        ...(strokeEnabled.checked
          ? {
              strokeStyle: {
                color: strokeColor.value.toUpperCase(),
                width: numberValue(strokeWidth),
              },
            }
          : {}),
        shadowStyle: {
          color: '#07102299',
          dx: 0,
          dy: 4,
          radius: 9,
        },
      },
    });

    const getImageLayer = (Position: PositionEnum) => ({
      src: state.logoSrc,
      ...(state.imageLayout === 'tile'
        ? {
            layout: {
              type: 'tile' as const,
              gapX: layoutValue(imageGapX),
              gapY: layoutValue(imageGapY),
              offsetX: layoutValue(imageLayoutX),
              offsetY: layoutValue(imageLayoutY),
              stagger: imageStagger.checked,
            },
          }
        : {
            position: {
              position: Position[imagePosition.value as keyof PositionEnum],
              X: numberValue(imageX),
              Y: numberValue(imageY),
            },
          }),
      alpha: numberValue(opacity),
      blendMode: imageBlend.value as 'normal' | 'multiply' | 'screen' | 'overlay' | 'darken' | 'lighten',
      scale: numberValue(scale),
      rotate: numberValue(imageRotation),
      trimTransparentPadding: true,
    });

    const methodName = (): 'markText' | 'markImage' | 'mark' => {
      if (state.mode === 'text') return 'markText';
      if (state.mode === 'image') return 'markImage';
      return 'mark';
    };

    const positionCode = (position: string, x: string, y: string) =>
      `{ position: Position.${position}, X: ${Number(x)}, Y: ${Number(y)} }`;

    const layoutValueCode = (input: HTMLInputElement) => {
      const value = input.value.trim();
      return value.endsWith('%') ? JSON.stringify(value) : String(Number(value));
    };

    const tileLayoutCode = (
      gapX: HTMLInputElement,
      gapY: HTMLInputElement,
      offsetX: HTMLInputElement,
      offsetY: HTMLInputElement,
      stagger: HTMLInputElement
    ) => `{
    type: 'tile',
    gapX: ${layoutValueCode(gapX)},
    gapY: ${layoutValueCode(gapY)},
    offsetX: ${layoutValueCode(offsetX)},
    offsetY: ${layoutValueCode(offsetY)},
    stagger: ${stagger.checked},
  }`;

    const textLayerCode = () => `{
  text: ${JSON.stringify(textInput.value || 'IMAGE MARKER')},
  alpha: ${Number(textOpacity.value)},
  blendMode: '${textBlend.value}',
  ${state.textLayout === 'tile'
    ? `layout: ${tileLayoutCode(textGapX, textGapY, textLayoutX, textLayoutY, textStagger)},`
    : `position: ${positionCode(textPosition.value, textX.value, textY.value)},`}
  style: {
    color: '${colorInput.value.toUpperCase()}',
    fontSize: ${Number(fontSize.value)},
    bold: ${bold.checked},
    rotate: ${Number(textRotation.value)},
    ${strokeEnabled.checked
      ? `strokeStyle: { color: '${strokeColor.value.toUpperCase()}', width: ${Number(strokeWidth.value)} },`
      : ''}
    shadowStyle: { color: '#07102299', dx: 0, dy: 4, radius: 9 },
  },
}`;

    const imageLayerCode = (target: CodeTarget) => `{
  src: ${target === 'web' ? "'/logo.png'" : "require('./logo.png')"},
  ${state.imageLayout === 'tile'
    ? `layout: ${tileLayoutCode(imageGapX, imageGapY, imageLayoutX, imageLayoutY, imageStagger)},`
    : `position: ${positionCode(imagePosition.value, imageX.value, imageY.value)},`}
  alpha: ${Number(opacity.value)},
  blendMode: '${imageBlend.value}',
  scale: ${Number(scale.value)},
  rotate: ${Number(imageRotation.value)},
  trimTransparentPadding: true,
}`;

    const indentCode = (value: string, spaces: number) =>
      value.replace(/^/gm, ' '.repeat(spaces));

    const createCode = (target: CodeTarget): string => {
      const method = methodName();
      const background = target === 'web' ? "'/photo.jpg'" : "require('./photo.jpg')";
      const outputFormat = format.value === 'jpg' ? 'jpg' : 'png';
      let layers = '';

      if (method === 'markText') {
        layers = `    watermarkTexts: [\n${indentCode(textLayerCode(), 6)}\n    ],`;
      } else if (method === 'markImage') {
        layers = `    watermarkImages: [\n${indentCode(imageLayerCode(target), 6)}\n    ],`;
      } else {
        const imageCode = imageLayerCode(target).replace(/^\{/, "{\n  type: 'image',");
        const textCode = textLayerCode().replace(/^\{/, "{\n  type: 'text',");
        layers = `    watermarks: [\n${indentCode(imageCode, 6)},\n${indentCode(textCode, 6)},\n    ],`;
      }

      const resultComment = target === 'web'
        ? '// Resolves to a data:image/... URL on Web.'
        : '// Resolves to a cache-file path on iOS and Android.';

      return `import Marker, { ImageFormat, Position } from 'react-native-image-marker';

${resultComment}
export async function createMarkedImage(): Promise<string> {
  return Marker.${method}({
    backgroundImage: { src: ${background} },
${layers}
    saveFormat: ImageFormat.${outputFormat},
    quality: ${Number(quality.value)},
    filename: 'marked-photo',
  });
}`;
    };

    const updateCode = () => {
      webCode.textContent = createCode('web');
      nativeCode.textContent = createCode('native');
    };

    const updateOutputs = () => {
      colorValue.textContent = colorInput.value.toUpperCase();
      strokeColorValue.textContent = strokeColor.value.toUpperCase();
      asElement<HTMLOutputElement>(root, '[data-font-size-output]').value = `${fontSize.value} px`;
      asElement<HTMLOutputElement>(root, '[data-text-opacity-output]').value = `${Math.round(Number(textOpacity.value) * 100)}%`;
      asElement<HTMLOutputElement>(root, '[data-stroke-width-output]').value = `${strokeWidth.value} px`;
      asElement<HTMLOutputElement>(root, '[data-text-rotation-output]').value = `${Number(textRotation.value) < 0 ? '−' : ''}${Math.abs(Number(textRotation.value))}°`;
      asElement<HTMLOutputElement>(root, '[data-opacity-output]').value = `${Math.round(Number(opacity.value) * 100)}%`;
      asElement<HTMLOutputElement>(root, '[data-scale-output]').value = `${Math.round(Number(scale.value) * 100)}%`;
      asElement<HTMLOutputElement>(root, '[data-image-rotation-output]').value = `${Number(imageRotation.value) < 0 ? '−' : ''}${Math.abs(Number(imageRotation.value))}°`;
      asElement<HTMLOutputElement>(root, '[data-quality-output]').value = quality.value;
      updateCode();
    };

    const setStatus = (kind: 'ready' | 'rendering' | 'rendered' | 'failed', message?: string) => {
      root.dataset.renderStatus = kind;
      previewFrame.setAttribute('aria-busy', kind === 'rendering' ? 'true' : 'false');
      status.dataset.state = kind;
      const key = kind === 'rendering' ? 'rendering' : kind;
      statusText.textContent = message ?? root.dataset[key] ?? '';
      renderButton.disabled = kind === 'rendering';
      renderButton.textContent = kind === 'rendering'
        ? root.dataset.rendering ?? ''
        : root.dataset.render ?? renderButton.dataset.defaultLabel ?? renderButton.textContent;
    };

    renderButton.dataset.defaultLabel = renderButton.textContent ?? '';
    root.dataset.render = renderButton.textContent ?? '';

    const updateWorkspace = (workspace: WorkspaceTab, focusPanel = false) => {
      state.workspace = workspace;
      root.dataset.workspace = workspace;
      workspaceTabs.forEach((tab) => {
        const selected = tab.dataset.workspaceTab === workspace;
        tab.setAttribute('aria-selected', String(selected));
        tab.tabIndex = selected ? 0 : -1;
      });
      workspacePanels.forEach((panel) => {
        const selected = panel.dataset.workspacePanel === workspace;
        panel.hidden = !selected;
        if (selected && focusPanel) panel.focus({ preventScroll: true });
      });
    };
    updateWorkspace(state.workspace);

    const updateMode = (mode: PlaygroundMode) => {
      state.mode = mode;
      root.dataset.mode = mode;
      root.querySelectorAll<HTMLButtonElement>('[data-mode]').forEach((button) => {
        const selected = button.dataset.mode === mode;
        button.classList.toggle('is-active', selected);
        button.setAttribute('aria-pressed', String(selected));
      });
      updateCode();
    };

    const updateLayout = (layer: 'text' | 'image', layout: LayoutMode) => {
      if (layer === 'text') state.textLayout = layout;
      else state.imageLayout = layout;

      root.querySelectorAll<HTMLButtonElement>(`[data-layout-layer="${layer}"]`).forEach((button) => {
        const selected = button.dataset.layout === layout;
        button.classList.toggle('is-active', selected);
        button.setAttribute('aria-pressed', String(selected));
      });
      asElement<HTMLElement>(root, `[data-single-options="${layer}"]`).hidden = layout !== 'single';
      asElement<HTMLElement>(root, `[data-tile-options="${layer}"]`).hidden = layout !== 'tile';
      updateCode();
    };

    const updateStrokeOptions = () => {
      root.querySelectorAll<HTMLElement>('[data-stroke-option]').forEach((option) => {
        option.classList.toggle('is-disabled-field', !strokeEnabled.checked);
        option.querySelectorAll<HTMLInputElement>('input').forEach((input) => {
          input.disabled = !strokeEnabled.checked;
        });
      });
      updateCode();
    };

    const setActiveExample = (example: string | undefined) => {
      root.querySelectorAll<HTMLButtonElement>('[data-example]').forEach((button) => {
        const selected = button.dataset.example === example;
        button.classList.toggle('is-active', selected);
        button.setAttribute('aria-pressed', String(selected));
      });
    };

    const setCustomSelectValue = (select: HTMLSelectElement, value: string) => {
      select.value = value;
      select.dispatchEvent(new Event('change', { bubbles: true }));
    };

    const applyExample = (example: string) => {
      setActiveExample(example);
      if (example === 'batch') {
        updateWorkspace('batch', true);
        return;
      }
      if (example === 'invisible') {
        updateWorkspace('invisible', true);
        return;
      }

      bold.checked = true;
      colorInput.value = '#ffffff';
      strokeColor.value = '#101828';
      textStagger.checked = true;
      setCustomSelectValue(textBlend, 'normal');
      setCustomSelectValue(imageBlend, 'normal');

      if (example === 'mixed') {
        updateMode('mixed');
        updateLayout('text', 'single');
        updateLayout('image', 'single');
        textInput.value = 'SHOT ON IMAGE MARKER';
        textOpacity.value = '0.85';
        fontSize.value = '42';
        strokeEnabled.checked = true;
        strokeWidth.value = '2';
        textRotation.value = '-7';
        opacity.value = '1';
        scale.value = '0.72';
        imageRotation.value = '0';
        textX.value = '48';
        textY.value = '48';
        imageX.value = '42';
        imageY.value = '42';
        setCustomSelectValue(textPosition, 'bottomLeft');
        setCustomSelectValue(imagePosition, 'topRight');
      } else if (example === 'outline') {
        updateMode('text');
        updateLayout('text', 'single');
        textInput.value = 'IMAGE MARKER';
        textOpacity.value = '1';
        fontSize.value = '48';
        strokeEnabled.checked = true;
        strokeWidth.value = '4';
        textRotation.value = '0';
        textX.value = '36';
        textY.value = '36';
        setCustomSelectValue(textPosition, 'topLeft');
      } else if (example === 'tiled-text') {
        updateMode('text');
        updateLayout('text', 'tile');
        textInput.value = 'CONFIDENTIAL';
        textOpacity.value = '0.55';
        fontSize.value = '30';
        strokeEnabled.checked = true;
        strokeWidth.value = '2';
        textRotation.value = '-24';
      } else if (example === 'tiled-logo') {
        updateMode('image');
        updateLayout('image', 'tile');
        opacity.value = '0.55';
        scale.value = '0.22';
        imageRotation.value = '-12';
        imageStagger.checked = true;
      } else if (example === 'opacity') {
        updateMode('text');
        updateLayout('text', 'single');
        textInput.value = 'PRIVATE PREVIEW';
        textOpacity.value = '0.4';
        fontSize.value = '48';
        strokeEnabled.checked = true;
        strokeWidth.value = '2';
        textRotation.value = '-7';
        textX.value = '0';
        textY.value = '0';
        setCustomSelectValue(textPosition, 'center');
      } else if (example === 'blend') {
        updateMode('mixed');
        updateLayout('text', 'single');
        updateLayout('image', 'single');
        textInput.value = 'SCREEN + MULTIPLY';
        textOpacity.value = '0.9';
        fontSize.value = '48';
        strokeEnabled.checked = false;
        textRotation.value = '0';
        opacity.value = '0.9';
        scale.value = '0.82';
        imageRotation.value = '-8';
        textX.value = '0';
        textY.value = '48';
        imageX.value = '0';
        imageY.value = '0';
        setCustomSelectValue(textPosition, 'bottomCenter');
        setCustomSelectValue(imagePosition, 'center');
        setCustomSelectValue(textBlend, 'screen');
        setCustomSelectValue(imageBlend, 'multiply');
      }

      updateStrokeOptions();
      scheduleRender();
    };

    const sourceAlt = preview.alt;
    let renderInFlight = false;
    let queuedSequence = 0;
    let renderTimer = 0;
    let batchController: AbortController | undefined;
    let batchObjectUrls: string[] = [];
    let invisibleResult = '';
    let invisibleController: AbortController | undefined;

    const clearBatchResults = () => {
      batchObjectUrls.forEach((url) => URL.revokeObjectURL(url));
      batchObjectUrls = [];
      batchResults.replaceChildren();
      batchSummary.textContent = '0 / 0';
      batchProgress.style.width = '0%';
      batchProgressbar?.setAttribute('aria-valuenow', '0');
    };

    const setBatchProgress = (settled: number, total: number) => {
      const percentage = total === 0 ? 0 : Math.round((settled / total) * 100);
      batchProgress.style.width = `${percentage}%`;
      batchProgressbar?.setAttribute('aria-valuenow', String(percentage));
      batchSummary.textContent = `${settled} / ${total}`;
    };

    const createBatchResultCard = (
      file: File,
      result: Awaited<ReturnType<ReturnType<MarkerSdk['default']['createRecipe']>['applyMany']>>[number]
    ) => {
      const card = document.createElement('article');
      card.className = 'batch-result-card';
      card.dataset.batchResult = result.status;

      if (result.status === 'fulfilled' && result.value instanceof Blob) {
        const url = URL.createObjectURL(result.value);
        batchObjectUrls.push(url);
        const image = document.createElement('img');
        image.src = url;
        image.alt = file.name;
        card.append(image);

        const downloadLink = document.createElement('a');
        const extension = result.value.type === 'image/jpeg' ? 'jpg' : 'png';
        downloadLink.href = url;
        downloadLink.download = `${file.name.replace(/\.[^.]+$/, '')}-marked.${extension}`;
        downloadLink.textContent = root.dataset.batchDownload ?? 'Save';
        downloadLink.className = 'batch-result-download';
        card.append(downloadLink);
      } else {
        const placeholder = document.createElement('div');
        placeholder.className = 'batch-result-placeholder';
        placeholder.textContent = result.status === 'aborted' ? '×' : '!';
        card.append(placeholder);
      }

      const meta = document.createElement('div');
      const name = document.createElement('strong');
      name.textContent = file.name;
      const statusLabel = document.createElement('span');
      statusLabel.textContent = result.status;
      meta.append(name, statusLabel);
      card.append(meta);
      return card;
    };

    const runBatch = async () => {
      const files = [...(batchFiles.files ?? [])];
      if (files.length < 2 || batchController) return;
      clearBatchResults();
      batchController = new AbortController();
      batchRun.disabled = true;
      batchCancel.disabled = false;
      batchFiles.disabled = true;
      batchStatus.textContent = `${root.dataset.batchRunning ?? ''} 0 / ${files.length}`;

      try {
        const sdk = await sdkPromise;
        const textLayer = {
          type: 'text' as const,
          ...getTextLayer(sdk.Position),
          text: `${textInput.value || 'IMAGE MARKER'} · {{sourceName}}`,
        };
        const imageLayer = { type: 'image' as const, ...getImageLayer(sdk.Position) };
        const watermarks = state.mode === 'text'
          ? [textLayer]
          : state.mode === 'image'
            ? [imageLayer]
            : [imageLayer, textLayer];
        const recipe = sdk.default.createRecipe(
          {
            watermarks,
            saveFormat: format.value === 'jpg' ? sdk.ImageFormat.jpg : sdk.ImageFormat.png,
            quality: numberValue(quality),
          },
          { resultType: 'blob' }
        );
        const results = await recipe.applyMany(
          files.map((file) => ({
            backgroundImage: { src: file },
            variables: { sourceName: file.name },
          })),
          {
            concurrency: 4,
            signal: batchController.signal,
            onProgress(progress) {
              setBatchProgress(progress.settled, progress.total);
              batchStatus.textContent = `${root.dataset.batchRunning ?? ''} ${progress.settled} / ${progress.total}`;
            },
          }
        );
        batchResults.replaceChildren(
          ...results.map((result, index) => createBatchResultCard(files[index]!, result))
        );
        const succeeded = results.filter((result) => result.status === 'fulfilled').length;
        const aborted = results.filter((result) => result.status === 'aborted').length;
        const failed = results.length - succeeded - aborted;
        batchStatus.textContent = `${root.dataset.batchComplete ?? ''}: ${succeeded} ✓ · ${failed} ! · ${aborted} ×`;
        setBatchProgress(results.length, results.length);
      } catch (error) {
        const message = error instanceof Error ? error.message : String(error);
        batchStatus.textContent = `${root.dataset.batchFailed ?? ''}: ${message}`;
      } finally {
        batchController = undefined;
        batchRun.disabled = files.length < 2;
        batchCancel.disabled = true;
        batchFiles.disabled = false;
      }
    };

    const setInvisibleBusy = (busy: boolean) => {
      invisibleEmbed.disabled = busy;
      invisibleDetect.disabled = busy || !invisibleResult;
      invisibleCancel.disabled = !busy || !invisibleController;
    };

    const showInvisibleResult = async (result: string) => {
      const size = await imageDimensions(result);
      state.result = result;
      preview.src = result;
      preview.alt = root.dataset.generatedAlt ?? '';
      dimensions.textContent = `${size.width} × ${size.height}`;
      resultUri.textContent = `${result.slice(0, 42)}…${result.slice(-16)}`;
      copyResultButton.disabled = false;
      download.href = result;
      download.download = `${root.dataset.filename ?? 'image-marker-web-demo'}-trace.png`;
      download.classList.remove('is-disabled');
      download.removeAttribute('aria-disabled');
    };

    const resizeInvisibleResult = async (result: string, scale: number) => {
      if (scale === 1) return result;
      const image = new Image();
      image.src = result;
      await image.decode();
      const canvas = document.createElement('canvas');
      canvas.width = Math.round(image.naturalWidth * scale);
      canvas.height = Math.round(image.naturalHeight * scale);
      const context = canvas.getContext('2d');
      if (!context) throw new Error('Canvas 2D is unavailable.');
      context.drawImage(image, 0, 0, canvas.width, canvas.height);
      return canvas.toDataURL('image/png');
    };

    const runInvisibleEmbed = async () => {
      setInvisibleBusy(true);
      invisibleStatus.textContent = root.dataset.invisibleEmbedding ?? '';
      const startedAt = performance.now();
      try {
        const sdk = await sdkPromise;
        const result = await sdk.default.embedInvisible({
          image: { src: state.backgroundSrc },
          payload: invisiblePayload.value,
          key: invisibleKey.value,
          strength: invisibleStrength.value as 'subtle' | 'balanced' | 'robust',
          saveFormat: sdk.ImageFormat.png,
          filename: `${root.dataset.filename ?? 'image-marker-web-demo'}-trace`,
        });
        invisibleResult = result;
        await showInvisibleResult(result);
        elapsed.textContent = `${Math.round(performance.now() - startedAt)} ms`;
        invisibleStatus.textContent = root.dataset.invisibleEmbedded ?? '';
        setStatus('rendered', root.dataset.invisibleEmbedded);
      } catch (error) {
        invisibleResult = '';
        const message = error instanceof Error ? error.message : String(error);
        invisibleStatus.textContent = `${root.dataset.failed ?? ''}: ${message}`;
        setStatus('failed', invisibleStatus.textContent);
      } finally {
        setInvisibleBusy(false);
      }
    };

    const runInvisibleDetect = async () => {
      if (!invisibleResult) return;
      setInvisibleBusy(true);
      invisibleStatus.textContent = root.dataset.invisibleDetecting ?? '';
      try {
        const sdk = await sdkPromise;
        const inspected = await resizeInvisibleResult(
          invisibleResult,
          Number(invisibleTransform.value)
        );
        await showInvisibleResult(inspected);
        const useWorker = invisibleExecutor.value === 'worker';
        invisibleController = useWorker ? new AbortController() : undefined;
        invisibleCancel.disabled = !invisibleController;
        const detection = await sdk.default.detectInvisible({
          image: { src: inspected },
          key: invisibleKey.value,
          strength: invisibleStrength.value as 'subtle' | 'balanced' | 'robust',
          search: 'robust',
          ...(useWorker
            ? {
                worker: {
                  scriptUrl: root.dataset.workerUrl ?? '/worker/invisible-watermark.js',
                  signal: invisibleController!.signal,
                  onProgress: ({ phase }: { phase: 'queued' | 'detecting' | 'complete' }) => {
                    if (phase === 'queued') {
                      invisibleStatus.textContent = root.dataset.invisibleWorkerQueued ?? '';
                    } else if (phase === 'detecting') {
                      invisibleStatus.textContent = root.dataset.invisibleWorkerRunning ?? '';
                    }
                  },
                },
              }
            : {}),
        });
        invisibleStatus.textContent = detection.detected
          ? `${root.dataset.invisibleDetected ?? ''}: ${detection.payload ?? '—'} · ${Math.round(detection.confidence * 100)}%${detection.scale ? ` · ${detection.scale}×` : ''}`
          : root.dataset.invisibleNotDetected ?? '';
      } catch (error) {
        const message = error instanceof Error ? error.message : String(error);
        invisibleStatus.textContent = error instanceof Error && error.name === 'AbortError'
          ? root.dataset.invisibleCancelled ?? ''
          : `${root.dataset.failed ?? ''}: ${message}`;
      } finally {
        invisibleController = undefined;
        setInvisibleBusy(false);
      }
    };

    const clearResult = () => {
      invisibleResult = '';
      invisibleDetect.disabled = true;
      state.result = '';
      preview.src = state.backgroundSrc;
      preview.alt = sourceAlt;
      dimensions.textContent = '—';
      elapsed.textContent = '—';
      resultUri.textContent = root.dataset.emptyResult ?? '';
      resultUri.removeAttribute('title');
      copyResultButton.disabled = true;
      download.href = '#';
      download.removeAttribute('download');
      download.classList.add('is-disabled');
      download.setAttribute('aria-disabled', 'true');
    };

    const render = async (sequence: number) => {
      if (renderInFlight) {
        queuedSequence = Math.max(queuedSequence, sequence);
        return;
      }

      renderInFlight = true;
      const startedAt = performance.now();
      setStatus('rendering');

      try {
        const sdk = await sdkPromise;
        const outputFormat = format.value === 'jpg' ? 'jpg' : 'png';
        const common = {
          backgroundImage: { src: state.backgroundSrc },
          saveFormat: outputFormat === 'jpg' ? sdk.ImageFormat.jpg : sdk.ImageFormat.png,
          quality: numberValue(quality),
          filename: root.dataset.filename ?? 'image-marker-web-demo',
        };
        const textLayer = getTextLayer(sdk.Position);
        const imageLayer = getImageLayer(sdk.Position);

        let result: string;
        if (state.mode === 'text') {
          result = await sdk.default.markText({ ...common, watermarkTexts: [textLayer] });
        } else if (state.mode === 'image') {
          result = await sdk.default.markImage({ ...common, watermarkImages: [imageLayer] });
        } else {
          result = await sdk.default.mark({
            ...common,
            watermarks: [
              { type: 'image', ...imageLayer },
              { type: 'text', ...textLayer },
            ],
          });
        }

        if (sequence !== state.renderSequence) return;
        const size = await imageDimensions(result);
        if (sequence !== state.renderSequence) return;

        state.result = result;
        preview.src = result;
        preview.alt = root.dataset.generatedAlt ?? '';
        dimensions.textContent = `${size.width} × ${size.height}`;
        elapsed.textContent = `${Math.round(performance.now() - startedAt)} ms`;
        resultUri.textContent = `${result.slice(0, 42)}…${result.slice(-16)}`;
        copyResultButton.disabled = false;
        download.href = result;
        download.download = `${root.dataset.filename ?? 'image-marker-web-demo'}.${outputFormat}`;
        download.classList.remove('is-disabled');
        download.removeAttribute('aria-disabled');
        setStatus('rendered');
      } catch (error) {
        if (sequence !== state.renderSequence) return;
        const message = error instanceof Error ? error.message : String(error);
        elapsed.textContent = `${Math.round(performance.now() - startedAt)} ms`;
        setStatus('failed', `${root.dataset.failed ?? ''}: ${message}`);
      } finally {
        renderInFlight = false;
        if (queuedSequence > sequence) {
          const nextSequence = queuedSequence;
          queuedSequence = 0;
          void render(nextSequence);
        }
      }
    };

    const requestRender = () => {
      window.clearTimeout(renderTimer);
      updateOutputs();
      const sequence = ++state.renderSequence;
      clearResult();
      void render(sequence);
    };

    const scheduleRender = () => {
      window.clearTimeout(renderTimer);
      updateOutputs();
      const sequence = ++state.renderSequence;
      if (!livePreview.checked) {
        queuedSequence = 0;
        setStatus('ready', root.dataset.pending);
        return;
      }
      clearResult();
      setStatus('rendering');
      renderTimer = window.setTimeout(() => void render(sequence), 220);
    };

    asElement<HTMLFormElement>(root, '[data-controls]').addEventListener('submit', (event) => {
      event.preventDefault();
      requestRender();
    });

    workspaceTabs.forEach((tab, index) => {
      tab.addEventListener('click', () => {
        updateWorkspace((tab.dataset.workspaceTab ?? 'visible') as WorkspaceTab);
      });
      tab.addEventListener('keydown', (event) => {
        let nextIndex = index;
        if (event.key === 'ArrowRight' || event.key === 'ArrowDown') {
          nextIndex = (index + 1) % workspaceTabs.length;
        } else if (event.key === 'ArrowLeft' || event.key === 'ArrowUp') {
          nextIndex = (index - 1 + workspaceTabs.length) % workspaceTabs.length;
        } else if (event.key === 'Home') {
          nextIndex = 0;
        } else if (event.key === 'End') {
          nextIndex = workspaceTabs.length - 1;
        } else {
          return;
        }
        event.preventDefault();
        const nextTab = workspaceTabs[nextIndex];
        nextTab?.focus();
        updateWorkspace((nextTab?.dataset.workspaceTab ?? 'visible') as WorkspaceTab);
      });
    });

    root.querySelectorAll<HTMLButtonElement>('[data-mode]').forEach((button) => {
      button.addEventListener('click', () => {
        setActiveExample(undefined);
        updateMode((button.dataset.mode ?? 'mixed') as PlaygroundMode);
        scheduleRender();
      });
    });

    root.querySelectorAll<HTMLButtonElement>('[data-layout-layer]').forEach((button) => {
      button.addEventListener('click', () => {
        setActiveExample(undefined);
        updateLayout(
          (button.dataset.layoutLayer ?? 'text') as 'text' | 'image',
          (button.dataset.layout ?? 'single') as LayoutMode
        );
        scheduleRender();
      });
    });

    root.querySelectorAll<HTMLButtonElement>('[data-example]').forEach((button) => {
      button.addEventListener('click', () => applyExample(button.dataset.example ?? 'mixed'));
    });

    const liveInputs = [
      textInput,
      colorInput,
      fontSize,
      textOpacity,
      textBlend,
      bold,
      strokeEnabled,
      strokeColor,
      strokeWidth,
      textRotation,
      textPosition,
      textX,
      textY,
      textGapX,
      textGapY,
      textLayoutX,
      textLayoutY,
      textStagger,
      opacity,
      scale,
      imageBlend,
      imageRotation,
      imagePosition,
      imageX,
      imageY,
      imageGapX,
      imageGapY,
      imageLayoutX,
      imageLayoutY,
      imageStagger,
      format,
      quality,
    ];
    liveInputs.forEach((input) => input.addEventListener('input', () => {
      setActiveExample(undefined);
      scheduleRender();
    }));
    strokeEnabled.addEventListener('change', updateStrokeOptions);
    format.addEventListener('change', scheduleRender);
    textPosition.addEventListener('change', scheduleRender);
    imagePosition.addEventListener('change', scheduleRender);
    livePreview.addEventListener('change', () => {
      if (livePreview.checked) {
        requestRender();
      } else {
        window.clearTimeout(renderTimer);
        queuedSequence = 0;
        ++state.renderSequence;
        setStatus('ready', root.dataset.pending);
      }
    });

    const bindFileInput = (
      input: HTMLInputElement,
      onLoad: (src: string) => void
    ) => {
      input.addEventListener('change', async () => {
        const file = input.files?.[0];
        if (!file) {
          setStatus('failed', root.dataset.noFile);
          return;
        }
        try {
          if (file.size > MAX_FILE_BYTES) {
            throw new Error(root.dataset.fileTooLarge);
          }
          const src = await readFileAsDataUrl(file);
          const size = await imageDimensions(src);
          if (size.width * size.height > MAX_IMAGE_PIXELS) {
            throw new Error(root.dataset.imageTooLarge);
          }
          onLoad(src);
          setStatus('ready', root.dataset.sourceLoaded);
          scheduleRender();
        } catch (error) {
          const expectedMessage = error instanceof Error
            && [root.dataset.fileTooLarge, root.dataset.imageTooLarge].includes(error.message)
            ? error.message
            : undefined;
          const message = expectedMessage ?? root.dataset.sourceFailed;
          setStatus('failed', message);
        }
      });
    };

    bindFileInput(backgroundFile, (src) => {
      state.backgroundSrc = src;
    });
    bindFileInput(logoFile, (src) => {
      state.logoSrc = src;
    });

    batchFiles.addEventListener('change', () => {
      clearBatchResults();
      const files = [...(batchFiles.files ?? [])];
      const invalid = files.find(
        (file) => file.size > MAX_FILE_BYTES || (file.type && !file.type.startsWith('image/'))
      );
      if (invalid) {
        batchStatus.textContent = root.dataset.fileTooLarge ?? root.dataset.sourceFailed ?? '';
        batchSelection.textContent = root.dataset.batchNone ?? '';
        batchRun.disabled = true;
        return;
      }
      batchSelection.textContent = files.length === 0
        ? root.dataset.batchNone ?? ''
        : `${files.length} ${root.dataset.batchSelected ?? ''}`;
      batchStatus.textContent = root.dataset.batchReady ?? '';
      batchRun.disabled = files.length < 2;
    });
    batchRun.addEventListener('click', () => void runBatch());
    batchCancel.addEventListener('click', () => {
      batchController?.abort();
      batchCancel.disabled = true;
      batchStatus.textContent = root.dataset.batchCancelling ?? '';
    });
    window.addEventListener('pagehide', clearBatchResults, { once: true });
    invisibleEmbed.addEventListener('click', () => void runInvisibleEmbed());
    invisibleDetect.addEventListener('click', () => void runInvisibleDetect());
    invisibleCancel.addEventListener('click', () => invisibleController?.abort());
    [invisiblePayload, invisibleKey, invisibleStrength, invisibleTransform, invisibleExecutor].forEach((input) => {
      input.addEventListener('input', () => {
        invisibleStatus.textContent = root.dataset.invisibleReady ?? '';
      });
    });

    asElement<HTMLButtonElement>(root, '[data-default-background]').addEventListener('click', () => {
      state.backgroundSrc = defaultBackground;
      backgroundFile.value = '';
      scheduleRender();
    });
    asElement<HTMLButtonElement>(root, '[data-default-logo]').addEventListener('click', () => {
      state.logoSrc = defaultLogo;
      logoFile.value = '';
      scheduleRender();
    });

    asElement<HTMLButtonElement>(root, '[data-reset]').addEventListener('click', () => {
      asElement<HTMLFormElement>(root, '[data-controls]').reset();
      state.backgroundSrc = defaultBackground;
      state.logoSrc = defaultLogo;
      backgroundFile.value = '';
      logoFile.value = '';
      updateMode('mixed');
      updateLayout('text', 'single');
      updateLayout('image', 'single');
      setActiveExample('mixed');
      invisiblePayload.value = 'asset-42';
      invisibleKey.value = 'example-only-key-2026';
      setCustomSelectValue(invisibleStrength, 'robust');
      setCustomSelectValue(invisibleTransform, '1');
      setCustomSelectValue(invisibleExecutor, 'worker');
      invisibleStatus.textContent = root.dataset.invisibleReady ?? '';
      updateStrokeOptions();
      scheduleRender();
    });

    renderButton.addEventListener('click', requestRender);

    copyResultButton.addEventListener('click', async () => {
      if (!state.result) return;
      try {
        await copyText(state.result);
        setStatus('rendered', root.dataset.copied);
      } catch {
        setStatus('failed', root.dataset.copyFailed);
      }
    });

    root.querySelectorAll<HTMLButtonElement>('[data-code-tab]').forEach((tab) => {
      tab.addEventListener('click', () => {
        const target = (tab.dataset.codeTab ?? 'web') as CodeTarget;
        state.codeTarget = target;
        root.querySelectorAll<HTMLButtonElement>('[data-code-tab]').forEach((candidate) => {
          const selected = candidate === tab;
          candidate.setAttribute('aria-selected', String(selected));
          candidate.tabIndex = selected ? 0 : -1;
        });
        root.querySelectorAll<HTMLElement>('[data-code-panel]').forEach((panel) => {
          panel.hidden = panel.dataset.codePanel !== target;
        });
      });

      tab.addEventListener('keydown', (event) => {
        const tabs = [...root.querySelectorAll<HTMLButtonElement>('[data-code-tab]')];
        const currentIndex = tabs.indexOf(tab);
        let nextIndex: number | undefined;
        if (event.key === 'ArrowLeft') nextIndex = (currentIndex - 1 + tabs.length) % tabs.length;
        if (event.key === 'ArrowRight') nextIndex = (currentIndex + 1) % tabs.length;
        if (event.key === 'Home') nextIndex = 0;
        if (event.key === 'End') nextIndex = tabs.length - 1;
        if (nextIndex === undefined) return;
        event.preventDefault();
        const next = tabs[nextIndex];
        next?.click();
        next?.focus();
      });
    });

    asElement<HTMLButtonElement>(root, '[data-copy-code]').addEventListener('click', async (event) => {
      const button = event.currentTarget as HTMLButtonElement;
      try {
        await copyText(state.codeTarget === 'web' ? webCode.textContent ?? '' : nativeCode.textContent ?? '');
        const original = button.textContent;
        button.textContent = root.dataset.copied ?? '';
        window.setTimeout(() => {
          button.textContent = original;
        }, 1500);
      } catch {
        setStatus('failed', root.dataset.copyFailed);
      }
    });

    download.addEventListener('click', (event) => {
      if (!state.result) event.preventDefault();
    });

    updateMode('mixed');
    updateLayout('text', 'single');
    updateLayout('image', 'single');
    updateStrokeOptions();
    updateOutputs();
    requestRender();
  });
</script>

