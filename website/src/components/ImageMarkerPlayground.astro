    gap: 0.45rem;
    margin: 0;
    padding: 0.3rem 0.6rem;
    border: 1px solid var(--playground-line);
    border-radius: 999px;
    color: var(--marker-ink);
    background: var(--playground-panel-raised);
    cursor: pointer;
  }

  .live-preview-toggle input {
    flex: none;
    width: 1rem;
    height: 1rem;
    margin: 0;
    accent-color: var(--marker-blue);
  }

  .live-preview-toggle strong,
  .live-preview-toggle small {
    display: block;
  }

  .live-preview-toggle strong {
    font-size: 0.7rem;
    line-height: 1.2;
  }

  .live-preview-toggle small {
    margin-top: 0.2rem;
    color: var(--marker-muted);
    font-size: 0.65rem;
    line-height: 1.45;
  }

  button,
  select,
  input,
  .secondary-button,
  .file-button {
    font: inherit;
  }

  button,
  .secondary-button,
  .file-button {
    min-height: 2.55rem;
    border-radius: 0.65rem;
    cursor: pointer;
  }

  button:focus-visible,
  select:focus-visible,
  input:focus-visible,
  .secondary-button:focus-visible,
  input[type='file']:focus-visible + .file-button {
    outline: 2px solid var(--marker-blue);
    outline-offset: 2px;
  }

  .primary-button,
  .secondary-button,
  .file-button,
  .quiet-button,
  .icon-button {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    border: 1px solid var(--playground-line);
    font-size: 0.78rem;
    font-weight: 690;
    text-decoration: none;
  }

  .primary-button {
    border-color: var(--marker-blue);
    color: #0b1020;
    background: var(--marker-blue);
  }

  .secondary-button,
  .file-button,
  .quiet-button,
  .icon-button {
    color: var(--marker-ink);
    background: var(--playground-panel-raised);
  }

  .primary-button:hover:not(:disabled),
  .secondary-button:hover:not(.is-disabled),
  .file-button:hover,
  .quiet-button:hover:not(:disabled),
  .icon-button:hover:not(:disabled) {
    filter: brightness(1.08);
  }

  button:disabled,
  .is-disabled {
    cursor: not-allowed;
    opacity: 0.5;
  }

  .quiet-button {
    min-height: 2rem;
    padding: 0.3rem 0.65rem;
  }

  .icon-button {
    width: 2.2rem;
    min-height: 2.2rem;
    padding: 0;
    font-size: 1rem;
  }

  .controls-panel {
    border-radius: 1rem;
  }

  .control-section {
    min-width: 0;
    min-inline-size: 0;
    margin: 0;
    padding: 1rem;
    border: 0;
    border-bottom: 1px solid var(--playground-line);
  }

  .control-section:last-child {
    border-bottom: 0;
  }

  .control-section legend {
    width: 100%;
    margin: 0 0 0.75rem;
    padding: 0;
    color: var(--marker-ink);
    font-size: 0.8rem;
    font-weight: 720;
    letter-spacing: -0.01em;
    line-height: 1.25;
  }

  .control-section legend > small {
    float: right;
    color: var(--marker-muted);
    font-size: 0.6rem;
    font-weight: 560;
    letter-spacing: 0;
  }

  .example-presets {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: 0.45rem;
  }

  .example-button {
    display: flex;
    min-width: 0;
    min-height: 3.45rem;
    flex-direction: column;
    align-items: stretch;
    justify-content: center;
    gap: 0.18rem;
    padding: 0.48rem 0.58rem;
    border: 1px solid var(--playground-line);
    border-radius: 0.65rem;
    color: var(--marker-ink);
    background: var(--playground-panel-raised);
    text-align: start;
  }

  .example-button > span {
    display: flex;
    min-width: 0;
    align-items: center;
    justify-content: space-between;
    gap: 0.35rem;
  }

  .example-button strong {
    min-width: 0;
    overflow: hidden;
    font-size: 0.68rem;
    font-weight: 700;
    line-height: 1.25;
    text-overflow: ellipsis;
    white-space: nowrap;
  }

  .example-button em {
    flex: none;
    padding: 0.08rem 0.28rem;
    border-radius: 999px;
    color: var(--marker-coral);
    background: color-mix(in srgb, var(--marker-coral) 12%, transparent);
    font-size: 0.52rem;
    font-style: normal;
    font-weight: 750;
  }

  .example-button > small {
    overflow: hidden;
    color: var(--marker-muted);
    font-size: 0.57rem;
    line-height: 1.3;
    text-overflow: ellipsis;
    white-space: nowrap;
  }

  .example-button:hover,
  .example-button.is-active {
    border-color: color-mix(in srgb, var(--marker-blue) 58%, var(--playground-line));
    background: color-mix(in srgb, var(--playground-panel-raised) 88%, var(--marker-blue));
  }

  .example-button.is-active {
    box-shadow: inset 0 0 0 1px color-mix(in srgb, var(--marker-blue) 38%, transparent);
  }

  .segmented-control {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 0.35rem;
    padding: 0.28rem;
    border: 1px solid var(--playground-line);
    border-radius: 0.72rem;
    background: color-mix(in srgb, var(--playground-panel) 76%, black);
  }

  .segmented-control button {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    min-height: 2.2rem;
    padding: 0.4rem 0.45rem;
    border: 0;
    color: var(--marker-muted);
    background: transparent;
    font-size: 0.73rem;
    font-weight: 680;
    line-height: 1.2;
    text-align: center;
  }

  .segmented-control button.is-active {
    color: var(--marker-ink);
    background: var(--playground-panel-raised);
    box-shadow: 0 0 0 1px var(--playground-line);
  }

  .file-row {
    display: flex;
    align-items: center;
    flex-wrap: wrap;
    gap: 0.55rem;
  }

  input[type='file'] {
    position: absolute;
    width: 1px;
    height: 1px;
    overflow: hidden;
    clip: rect(0 0 0 0);
    clip-path: inset(50%);
    white-space: nowrap;
  }

  .file-button {
    min-height: 2.2rem;
    padding: 0.36rem 0.65rem;
    line-height: 1.2;
    text-align: center;
  }

  .text-button {
    display: inline-flex;
    align-items: center;
    min-height: auto;
    padding: 0.3rem 0.2rem;
    border: 0;
    color: var(--marker-blue);
    background: transparent;
    font-size: 0.7rem;
    font-weight: 650;
    line-height: 1.2;
  }

  .field-hint {
    margin: 0.55rem 0 0;
    color: var(--marker-muted);
    font-size: 0.66rem;
    line-height: 1.5;
  }

  .field-grid {
    display: grid;
    grid-template-columns: minmax(0, 1.4fr) repeat(2, minmax(4.7rem, 0.55fr));
    align-items: end;
    gap: 0.65rem;
    margin-top: 0.75rem;
  }

  .field-grid-3 {
    grid-template-columns: minmax(0, 0.9fr) minmax(0, 1.2fr);
  }

  .image-basic-grid {
    grid-template-columns: repeat(2, minmax(0, 1fr));
  }

  .field-grid-3 .check-field {
    grid-column: auto;
  }

  .stroke-grid {
    grid-template-columns: minmax(7rem, 0.7fr) minmax(8rem, 0.9fr) minmax(0, 1.25fr);
  }

  .stroke-grid .check-field {
    grid-column: auto;
  }

  .is-disabled-field {
    opacity: 0.48;
  }

  .advanced-controls {
    margin-top: 0.8rem;
    padding-top: 0.7rem;
    border-top: 1px solid var(--playground-line);
  }

  .advanced-controls summary {
    color: var(--marker-blue);
    font-size: 0.7rem;
    font-weight: 680;
    cursor: pointer;
  }

  .advanced-controls summary::marker {
    color: var(--marker-muted);
  }

  .layout-choice {
    display: grid;
    grid-template-columns: minmax(5rem, 0.55fr) minmax(0, 1.45fr);
    align-items: center;
    gap: 0.65rem;
    margin-top: 0.8rem;
  }

  .layout-choice > span {
    color: var(--marker-muted);
    font-size: 0.67rem;
    font-weight: 650;
  }

  .primary-layout-choice {
    padding: 0.55rem 0.62rem;
    border: 1px solid var(--playground-line);
    border-radius: 0.7rem;
    background: color-mix(in srgb, var(--playground-panel-raised) 92%, var(--marker-blue) 3%);
  }

  .layout-control {
    grid-template-columns: repeat(2, minmax(0, 1fr));
  }

  .option-grid {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    align-items: end;
    gap: 0.65rem;
    margin-top: 0.75rem;
  }

  .tile-options .check-field {
    grid-column: 1 / -1;
  }

  [hidden] {
    display: none !important;
  }

  .advanced-grid {
    grid-template-columns: repeat(2, minmax(0, 1fr));
  }

  .field,
  .check-field {
    display: flex;
    min-width: 0;
    flex-direction: column;
    gap: 0.35rem;
    color: var(--marker-muted);
    font-size: 0.67rem;
    font-weight: 650;
    line-height: 1.35;
  }

  .field-full {
    width: 100%;
  }

  .field > span:first-child,
  .check-field > span {
    min-height: 1rem;
  }

  .field output {
    float: right;
    color: var(--marker-ink);
    font-family: var(--sl-font-mono);
    font-size: 0.62rem;
  }

  .field input[type='text'],
  .field input[type='password'],
  .field input[type='number'],
  .field select {
    width: 100%;
    height: 2.35rem;
    min-width: 0;
    padding: 0 0.62rem;
    border: 1px solid var(--playground-line);
    border-radius: 0.55rem;
    color: var(--marker-ink);
    background: var(--playground-panel-raised);
    font-size: 0.75rem;
  }

  .color-input-wrap {
    display: grid;
    grid-template-columns: 2.35rem 1fr;
    align-items: center;
    height: 2.35rem;
    overflow: hidden;
    border: 1px solid var(--playground-line);
    border-radius: 0.55rem;
    background: var(--playground-panel-raised);
  }

  .color-input-wrap input {
    width: 2.35rem;
    height: 2.35rem;
    padding: 0;
    border: 0;
    background: transparent;
    cursor: pointer;
  }

  .color-input-wrap code {
    padding-left: 0.45rem;
    color: var(--marker-ink);
    font-size: 0.65rem;
  }

  .range-field input[type='range'] {
    width: 100%;
    min-width: 0;
    height: 2.35rem;
    margin: 0;
    accent-color: var(--marker-blue);
    cursor: pointer;
  }

  .check-field {
    align-self: end;
    flex-direction: row;
    align-items: center;
    min-height: 2.35rem;
    padding: 0 0.65rem;
    border: 1px solid var(--playground-line);
    border-radius: 0.55rem;
    color: var(--marker-ink);
    background: var(--playground-panel-raised);
  }

  .check-field input {
    width: 1rem;
    height: 1rem;
    margin: 0;
    accent-color: var(--marker-blue);
  }

  [data-mode='text'] [data-image-controls],
  [data-mode='image'] [data-text-controls] {
    display: none;
  }

  .output-grid {
    grid-template-columns: minmax(0, 0.7fr) minmax(0, 1.3fr);
    margin-top: 0;
  }

  .invisible-panel {
    padding: 1rem;
    background:
      radial-gradient(circle at 88% 10%, color-mix(in srgb, var(--marker-blue) 13%, transparent), transparent 30%),
      var(--playground-panel);
  }

  .invisible-heading {
    display: flex;
    flex-direction: column;
    align-items: flex-start;
    gap: 0.75rem;
  }

  .invisible-heading h3 {
    margin: 0;
    color: var(--marker-ink);
    font-size: 1.05rem;
    letter-spacing: -0.025em;
  }

  .invisible-heading p:last-child {
    max-width: 72ch;
    margin: 0.35rem 0 0;
    color: var(--marker-muted);
    font-size: 0.72rem;
    line-height: 1.55;
  }

  .invisible-status {
    flex: none;
    max-width: 100%;
    padding: 0.35rem 0.62rem;
    border: 1px solid var(--playground-line);
    border-radius: 999px;
    color: var(--marker-blue);
    background: var(--playground-panel-raised);
    font-family: var(--sl-font-mono);
    font-size: 0.64rem;
    line-height: 1.4;
    text-align: left;
  }

  .invisible-controls {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    align-items: end;
    gap: 0.75rem;
    margin-top: 1rem;
    padding-top: 1rem;
    border-top: 1px solid var(--playground-line);
  }

  .invisible-actions {
    display: flex;
    gap: 0.55rem;
    margin-top: 0.75rem;
  }

  .invisible-actions button {
    min-width: 0;
    flex: 1 1 8rem;
    padding-inline: 0.85rem;
  }

  .invisible-warning {
    margin: 0.75rem 0 0;
    color: var(--marker-muted);
    font-size: 0.66rem;
    line-height: 1.5;
  }

  .invisible-code {
    margin-top: 0.75rem;
    color: var(--marker-muted);
    font-size: 0.68rem;
  }

  .invisible-code summary {
    width: fit-content;
    cursor: pointer;
    color: var(--marker-blue);
    font-weight: 700;
  }

  .invisible-code pre {
    overflow-x: auto;
    margin: 0.6rem 0 0;
    padding: 0.85rem;
    border: 1px solid var(--playground-line);
    border-radius: 0.7rem;
    background: var(--playground-panel-raised);
    color: var(--marker-ink);
    font-size: 0.66rem;
    line-height: 1.55;
  }

  .invisible-code p {
    margin: 0.7rem 0;
    color: var(--marker-muted);
    font-weight: 500;
    line-height: 1.55;
  }

  .invisible-code a {
    display: inline-flex;
    margin-top: 0.65rem;
    color: var(--marker-blue);
  }

  .batch-panel {
    padding: 1rem;
  }

  .batch-heading {
    display: grid;
    grid-template-columns: minmax(0, 1fr);
    align-items: start;
    gap: 0.85rem;
  }

  .batch-heading h3,
  .batch-results-heading h4 {
    margin: 0;
    color: var(--marker-ink);
    letter-spacing: -0.025em;
  }

  .batch-heading h3 {
    font-size: 1.05rem;
  }

  .batch-heading p:last-child {
    max-width: 70ch;
    margin: 0.35rem 0 0;
    color: var(--marker-muted);
    font-size: 0.72rem;
    line-height: 1.55;
  }

  .batch-picker {
    display: flex;
    align-items: center;
    flex-wrap: wrap;
    justify-content: flex-start;
    gap: 0.55rem;
  }

  .batch-picker > span,
  .batch-progress-row > span,
  .batch-results-heading > span {
    color: var(--marker-muted);
    font-family: var(--sl-font-mono);
    font-size: 0.67rem;
  }

  .batch-progress-row {
    display: grid;
    grid-template-columns: minmax(0, 1fr);
    align-items: center;
    gap: 0.8rem;
    margin-top: 1rem;
    padding-top: 1rem;
    border-top: 1px solid var(--playground-line);
  }

  .batch-progress {
    height: 0.5rem;
    overflow: hidden;
    border-radius: 999px;
    background: var(--playground-panel-raised);
  }

  .batch-progress > span {
    display: block;
    width: 0;
    height: 100%;
    border-radius: inherit;
    background: linear-gradient(90deg, var(--marker-blue), var(--marker-coral));
    transition: width 160ms ease;
  }

  .batch-actions {
    display: flex;
    gap: 0.5rem;
  }

  .batch-actions .primary-button,
  .batch-actions .quiet-button {
    padding-inline: 0.8rem;
  }

  .batch-results-heading {
    display: flex;
    align-items: center;
    justify-content: space-between;
    margin-top: 1rem;
  }

  .batch-results-heading h4 {
    font-size: 0.78rem;
  }

  .batch-results {
    display: grid;
    grid-template-columns: minmax(0, 1fr);
    gap: 0.65rem;
    margin-top: 0.65rem;
  }

  .batch-results:empty {
    display: none;
  }

  .batch-results :global(.batch-result-card) {
    position: relative;
    min-width: 0;
    overflow: hidden;
    border: 1px solid var(--playground-line);
    border-radius: 0.75rem;
    background: var(--playground-panel-raised);
  }

  .batch-results :global(.batch-result-card img),
  .batch-results :global(.batch-result-placeholder) {
    display: block;
    width: 100%;
    aspect-ratio: 4 / 3;
    object-fit: cover;
    background: #090b11;
  }

  .batch-results :global(.batch-result-placeholder) {
    display: grid;
    place-items: center;
    color: var(--marker-coral);
    font-size: 2rem;
    font-weight: 760;
  }

  .batch-results :global(.batch-result-card > div:last-child) {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 0.5rem;
    padding: 0.6rem;
  }

  .batch-results :global(.batch-result-card strong) {
    overflow: hidden;
    color: var(--marker-ink);
    font-size: 0.67rem;
    text-overflow: ellipsis;
    white-space: nowrap;
  }

  .batch-results :global(.batch-result-card > div:last-child span) {
    flex: none;
    color: var(--marker-muted);
    font-size: 0.6rem;
  }

  .batch-results :global(.batch-result-download) {
    position: absolute;
    top: 0.5rem;
    right: 0.5rem;
    padding: 0.3rem 0.5rem;
    border-radius: 999px;
    color: #0b1020;
    background: rgb(255 255 255 / 88%);
    font-size: 0.62rem;
    font-weight: 720;
    text-decoration: none;
  }

  .code-panel {
    margin-top: 1rem;
    overflow: hidden;
  }

  .code-heading {
    padding: 1rem;
    border-bottom: 1px solid var(--playground-line);
  }

  .code-heading p {
    margin: 0.3rem 0 0;
    color: var(--marker-muted);
    font-size: 0.74rem;
  }

  .code-tabs {
    display: flex;
    gap: 0.2rem;
    padding: 0.55rem 0.8rem 0;
  }

  .code-tabs button {
    min-height: 2.1rem;
    padding: 0.35rem 0.7rem;
    border: 0;
    border-bottom: 2px solid transparent;
    border-radius: 0;
    color: var(--marker-muted);
    background: transparent;
    font-size: 0.72rem;
    font-weight: 690;
  }

  .code-tabs button[aria-selected='true'] {
    border-bottom-color: var(--marker-coral);
    color: var(--marker-ink);
  }

  .code-view {
    border-top: 1px solid var(--playground-line);
    background: #0c0f17;
  }

  .code-view pre {
    max-height: 31rem;
    margin: 0;
    padding: 1.15rem;
    overflow: auto;
    background: transparent;
    font-size: 0.72rem;
    line-height: 1.65;
  }

  .code-view code {
    color: #dfe5f4;
  }

  .differences {
    margin-top: 1rem;
    padding: 1rem;
  }

  .differences dl {
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    gap: 0;
    margin: 0.9rem 0 0;
    border-top: 1px solid var(--playground-line);
    border-left: 1px solid var(--playground-line);
  }

  .differences dl > div {
    padding: 0.9rem;
    border-right: 1px solid var(--playground-line);
    border-bottom: 1px solid var(--playground-line);
  }

  .differences dt {
    color: var(--marker-ink);
    font-size: 0.72rem;
    font-weight: 720;
  }

  .differences dd {
    margin: 0.35rem 0 0;
    color: var(--marker-muted);
    font-size: 0.7rem;
    line-height: 1.55;
  }

  .sr-only {
    position: absolute;
    width: 1px;
    height: 1px;
    padding: 0;
    margin: -1px;
    overflow: hidden;
    clip: rect(0, 0, 0, 0);
    white-space: nowrap;
    border: 0;
  }

  @media (max-width: 72rem) {
    .invisible-controls {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }
  }

  @media (max-width: 52rem) {
    .playground-shell {
      grid-template-areas:
        'preview'
        'controls';
      grid-template-columns: 1fr;
    }

    .marker-playground[data-workspace='batch'] .playground-shell,
    .marker-playground[data-workspace='invisible'] .playground-shell {
      grid-template-columns: 1fr;
    }

    .preview-panel,
    .workspace-panel-stack {
      position: static;
      max-height: none;
    }

    .workspace-panel-stack > [data-workspace-panel] {
      max-height: none;
      overflow-y: visible;
      scrollbar-gutter: auto;
    }

  }

  @media (max-width: 44rem) {
    :global(.content-panel:has(.marker-playground)) {
      padding-inline: 0.75rem;
    }

    .marker-playground {
      margin-bottom: 3rem;
    }

    .workspace-tabs {
      gap: 0.25rem;
      padding: 0.28rem;
    }

    .workspace-tabs button {
      min-height: 2.85rem;
      align-items: center;
      padding: 0.45rem 0.3rem;
      text-align: center;
    }

    .workspace-tabs button > span {
      justify-content: center;
      font-size: 0.68rem;
    }

    .workspace-tabs small {
      display: none;
    }

    .playground-heading {
      align-items: flex-start;
      flex-direction: column;
      gap: 1rem;
    }

    .playground-heading h1 {
      font-size: clamp(2rem, 11vw, 3rem);
    }

    .preview-panel,
    .control-section,
    .differences,
    .code-heading {
      padding: 0.8rem;
    }

    .preview-frame {
      min-height: 10rem;
    }

    .render-meta {
