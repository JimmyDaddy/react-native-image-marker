const formats = [
  { value: 'png', label: 'PNG' },
  { value: 'jpg', label: 'JPEG' },
];
const blendModes = [
  { value: 'normal', label: isZh ? '普通' : 'Normal' },
  { value: 'multiply', label: isZh ? '正片叠底' : 'Multiply' },
  { value: 'screen', label: isZh ? '滤色' : 'Screen' },
  { value: 'overlay', label: isZh ? '叠加' : 'Overlay' },
  { value: 'darken', label: isZh ? '变暗' : 'Darken' },
  { value: 'lighten', label: isZh ? '变亮' : 'Lighten' },
];
const invisibleStrengths = ['subtle', 'balanced', 'robust'].map((value, index) => ({
  value,
  label: strings.invisibleStrengths[index]!,
}));
const invisibleTransforms = ['1', '0.9', '1.1'].map((value, index) => ({
  value,
  label: strings.invisibleTransforms[index]!,
}));
const invisibleExecutors = ['main', 'worker'].map((value, index) => ({
  value,
  label: strings.invisibleExecutors[index]!,
}));
---

<section
  class="marker-playground not-content"
  data-marker-playground
  data-workspace="visible"
  data-locale={locale}
  data-background-url={`${base}media/playground-background.jpg`}
  data-logo-url={`${base}media/marker-compass.png`}
  data-worker-url={`${base}worker/invisible-watermark.js`}
  data-ready={strings.ready}
  data-rendering={strings.rendering}
  data-rendered={strings.rendered}
  data-failed={strings.failed}
  data-pending={strings.pending}
  data-source-loaded={strings.sourceLoaded}
  data-source-failed={strings.sourceFailed}
  data-no-file={strings.noFile}
  data-file-too-large={strings.fileTooLarge}
  data-image-too-large={strings.imageTooLarge}
  data-empty-result={strings.emptyResult}
  data-copied={strings.copied}
  data-copy-failed={strings.copyFailed}
  data-generated-alt={strings.generatedAlt}
  data-filename={strings.filename}
  data-batch-none={strings.batchNone}
  data-batch-selected={strings.batchSelected}
  data-batch-ready={strings.batchReady}
  data-batch-running={strings.batchRunning}
  data-batch-cancelling={strings.batchCancelling}
  data-batch-complete={strings.batchComplete}
  data-batch-failed={strings.batchFailed}
  data-batch-download={strings.downloadResult}
  data-invisible-ready={strings.invisibleReady}
  data-invisible-embedding={strings.invisibleEmbedding}
  data-invisible-embedded={strings.invisibleEmbedded}
  data-invisible-detecting={strings.invisibleDetecting}
  data-invisible-worker-queued={strings.invisibleWorkerQueued}
  data-invisible-worker-running={strings.invisibleWorkerRunning}
  data-invisible-cancelled={strings.invisibleCancelled}
  data-invisible-detected={strings.invisibleDetected}
  data-invisible-not-detected={strings.invisibleNotDetected}
>
  <header class="playground-heading">
    <div>
      <p class="eyebrow">{strings.eyebrow}</p>
      <h1>{strings.title}</h1>
      <p class="heading-description">{strings.description}</p>
    </div>
    <span class="privacy-badge">
      <span aria-hidden="true"></span>
      {strings.privacy}
    </span>
  </header>

  <ol class="playground-steps" aria-label={isZh ? '使用步骤' : 'How to use the playground'}>
    {strings.steps.map((step, index) => (
      <li>
        <span>{index + 1}</span>
        {step}
      </li>
    ))}
  </ol>

  <div class="workspace-tabs" role="tablist" aria-label={strings.workspaceLabel}>
    <button
      id={`${idPrefix}-workspace-visible-tab`}
      type="button"
      role="tab"
      aria-selected="true"
      aria-controls={`${idPrefix}-workspace-visible`}
      tabindex="0"
      data-workspace-tab="visible"
    >
      <span>{strings.visibleTab}</span>
      <small>{strings.visibleTabMeta}</small>
    </button>
    <button
      id={`${idPrefix}-workspace-batch-tab`}
      type="button"
      role="tab"
      aria-selected="false"
      aria-controls={`${idPrefix}-workspace-batch`}
      tabindex="-1"
      data-workspace-tab="batch"
    >
      <span>{strings.batchTab} <em>v1.9</em></span>
      <small>{strings.batchTabMeta}</small>
    </button>
    <button
      id={`${idPrefix}-workspace-invisible-tab`}
      type="button"
      role="tab"
      aria-selected="false"
      aria-controls={`${idPrefix}-workspace-invisible`}
      tabindex="-1"
      data-workspace-tab="invisible"
    >
      <span>{strings.invisibleTab} <em>v1.12</em></span>
      <small>{strings.invisibleTabMeta}</small>
    </button>
  </div>

  <div class="playground-shell">
    <section class="preview-panel" aria-labelledby={`${idPrefix}-preview-title`}>
      <div class="panel-heading">
        <div>
          <p class="panel-kicker">{strings.webBadge}</p>
          <h3 id={`${idPrefix}-preview-title`}>{strings.previewTitle}</h3>
        </div>
        <div class="panel-tools">
          <label class="live-preview-toggle">
            <input type="checkbox" checked data-live-preview />
            <span>
              <strong>{strings.autoPreview}</strong>
              <small class="sr-only">{strings.autoPreviewHint}</small>
            </span>
          </label>
          <button class="quiet-button" type="button" data-reset>{strings.reset}</button>
        </div>
      </div>

      <div class="preview-frame" data-preview-frame aria-busy="true">
        <img
          src={`${base}media/playground-background.jpg`}
          alt={strings.builtInAlt}
          width="1600"
          height="1000"
          data-preview
        />
        <div class="render-overlay" data-render-overlay aria-hidden="true">
          <span class="spinner" aria-hidden="true"></span>
          <span>{strings.rendering}</span>
        </div>
      </div>

      <div class="render-meta" aria-live="polite" aria-atomic="true">
        <span class="render-state" data-render-state>
          <span aria-hidden="true"></span>
          <span data-status-text>{strings.ready}</span>
        </span>
        <span class="metric"><strong>{strings.dimensions}</strong> <span data-dimensions>—</span></span>
        <span class="metric"><strong>{strings.elapsed}</strong> <span data-elapsed>—</span></span>
      </div>

      <div class="result-row">
        <div class="result-value">
          <span>{strings.resultLabel}</span>
          <code data-result-uri>{strings.emptyResult}</code>
        </div>
        <button class="icon-button" type="button" data-copy-result disabled title={strings.copyResult}>
          <span class="sr-only">{strings.copyResult}</span>
          <span aria-hidden="true">⧉</span>
        </button>
      </div>

      <div class="preview-actions">
        <button class="primary-button" type="button" data-render>{strings.render}</button>
        <a class="secondary-button is-disabled" href="#" data-download aria-disabled="true">
          {strings.download}
        </a>
      </div>
    </section>

    <div class="workspace-panel-stack">
    <form
      id={`${idPrefix}-workspace-visible`}
      class="controls-panel"
      role="tabpanel"
      aria-labelledby={`${idPrefix}-workspace-visible-tab`}
      data-controls
      data-workspace-panel="visible"
