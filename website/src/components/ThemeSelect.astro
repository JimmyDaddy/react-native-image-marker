---
const pathname = Astro.url.pathname;
const isZh = pathname === '/zh-cn/' || pathname.startsWith('/zh-cn/');
const labels = isZh
  ? {
      accessible: '切换主题',
      auto: ['自动', '跟随系统外观'],
      light: ['浅色', '始终使用浅色外观'],
      dark: ['深色', '始终使用深色外观'],
    }
  : {
      accessible: 'Change theme',
      auto: ['Auto', 'Follow your system'],
      light: ['Light', 'Always use the light theme'],
      dark: ['Dark', 'Always use the dark theme'],
    };

const themes = [
  { value: 'auto', icon: '◐', label: labels.auto[0], description: labels.auto[1] },
  { value: 'light', icon: '☀', label: labels.light[0], description: labels.light[1] },
  { value: 'dark', icon: '●', label: labels.dark[0], description: labels.dark[1] },
] as const;
---

<starlight-theme-select>
  <details class="preference-menu theme-select" data-theme-menu>
    <summary aria-label={labels.accessible}>
      <span class="preference-icon" data-theme-icon aria-hidden="true">◐</span>
      <span data-theme-label>{labels.auto[0]}</span>
      <span class="preference-caret" aria-hidden="true">⌄</span>
    </summary>
    <div class="preference-popover" role="menu" aria-label={labels.accessible}>
      {themes.map((theme) => (
        <button
          type="button"
          role="menuitemradio"
          aria-checked={theme.value === 'auto' ? 'true' : 'false'}
          data-theme-option={theme.value}
          data-theme-label-value={theme.label}
          data-theme-icon-value={theme.icon}
        >
          <span class="preference-choice-icon" aria-hidden="true">{theme.icon}</span>
          <span>
            <strong>{theme.label}</strong>
            <small>{theme.description}</small>
          </span>
          <span class="selected-check" aria-hidden="true">✓</span>
        </button>
      ))}
    </div>
  </details>
</starlight-theme-select>

<script>
  type Theme = 'auto' | 'dark' | 'light';

  const storageKey = 'starlight-theme';
  const parseTheme = (value: unknown): Theme =>
    value === 'dark' || value === 'light' || value === 'auto' ? value : 'auto';
  const loadTheme = (): Theme => parseTheme(localStorage.getItem(storageKey) || 'auto');
  const systemTheme = (): Exclude<Theme, 'auto'> =>
    matchMedia('(prefers-color-scheme: light)').matches ? 'light' : 'dark';

  const syncThemeMenus = (theme: Theme) => {
    document.querySelectorAll<HTMLDetailsElement>('[data-theme-menu]').forEach((menu) => {
      const selected = menu.querySelector<HTMLButtonElement>(`[data-theme-option="${theme}"]`);
      const label = menu.querySelector<HTMLElement>('[data-theme-label]');
      const icon = menu.querySelector<HTMLElement>('[data-theme-icon]');
      if (label && selected?.dataset.themeLabelValue) {
        label.textContent = selected.dataset.themeLabelValue;
      }
      if (icon && selected?.dataset.themeIconValue) {
        icon.textContent = selected.dataset.themeIconValue;
      }
      menu.querySelectorAll<HTMLButtonElement>('[data-theme-option]').forEach((option) => {
        option.setAttribute('aria-checked', String(option.dataset.themeOption === theme));
      });
    });
  };

  const applyTheme = (theme: Theme) => {
    document.documentElement.dataset.theme = theme === 'auto' ? systemTheme() : theme;
    localStorage.setItem(storageKey, theme === 'auto' ? '' : theme);
    syncThemeMenus(theme);
  };

  const closeOtherPreferenceMenus = (current: HTMLDetailsElement) => {
    document.querySelectorAll<HTMLDetailsElement>('.preference-menu[open]').forEach((menu) => {
      if (menu !== current) menu.open = false;
    });
  };

  document.querySelectorAll<HTMLDetailsElement>('[data-theme-menu]').forEach((menu) => {
    if (menu.dataset.initialized === 'true') return;
    menu.dataset.initialized = 'true';

    menu.addEventListener('toggle', () => {
      if (menu.open) closeOtherPreferenceMenus(menu);
    });
    menu.querySelectorAll<HTMLButtonElement>('[data-theme-option]').forEach((option) => {
      option.addEventListener('click', () => {
        applyTheme(parseTheme(option.dataset.themeOption));
        menu.open = false;
        menu.querySelector('summary')?.focus();
      });
    });
    menu.addEventListener('keydown', (event) => {
      const options = [...menu.querySelectorAll<HTMLButtonElement>('[data-theme-option]')];
      const currentIndex = options.indexOf(document.activeElement as HTMLButtonElement);
      let nextIndex: number | undefined;
      if (event.key === 'ArrowDown') nextIndex = currentIndex < 0 ? 0 : (currentIndex + 1) % options.length;
      if (event.key === 'ArrowUp') nextIndex = currentIndex < 0 ? options.length - 1 : (currentIndex - 1 + options.length) % options.length;
      if (event.key === 'Home') nextIndex = 0;
      if (event.key === 'End') nextIndex = options.length - 1;
      if (nextIndex !== undefined) {
        event.preventDefault();
        options[nextIndex]?.focus();
      }
      if (event.key === 'Escape') {
        menu.open = false;
        menu.querySelector('summary')?.focus();
      }
    });
  });

  document.addEventListener('click', (event) => {
    const target = event.target;
    if (!(target instanceof Node)) return;
    document.querySelectorAll<HTMLDetailsElement>('[data-theme-menu][open]').forEach((menu) => {
      if (!menu.contains(target)) menu.open = false;
    });
  });

  const themeMedia = matchMedia('(prefers-color-scheme: light)');
  themeMedia.addEventListener('change', () => {
    if (loadTheme() === 'auto') applyTheme('auto');
  });
  applyTheme(loadTheme());
</script>
