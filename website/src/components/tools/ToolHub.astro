---
import { toolGroups, toolHref } from '../../data/tools.mjs';

interface Props { locale?: 'en' | 'zh-CN' }
const { locale = 'en' } = Astro.props;
const zh = locale === 'zh-CN';
const language = zh ? 'zh' : 'en';
let toolIndex = 0;
---

<div class="tool-hub">
  {toolGroups.map((group) => (
    <section class="tool-hub-group" aria-labelledby={`tool-group-${group.id}`}>
      <header>
        <h2 id={`tool-group-${group.id}`}>{group.label[language]}</h2>
        <p>{group.description[language]}</p>
      </header>
      <div class="tool-hub-grid">
        {group.tools.map((tool) => {
          const index = toolIndex++;
          return (
            <a
              class:list={[
                'tool-hub-card',
                index === 0 && 'tool-hub-card-featured',
              ]}
              href={toolHref(tool, language)}
              data-tool-id={tool.id}
            >
              <span class="tool-hub-index">{String(index + 1).padStart(2, '0')}</span>
              <span class="tool-hub-badge">{tool.badge[language]}</span>
              <h3>{tool.label[language]}</h3>
              <p>{tool.description[language]}</p>
              <strong>{zh ? '打开工具' : 'Open tool'} <span aria-hidden="true">→</span></strong>
            </a>
          );
        })}
      </div>
    </section>
  ))}
</div>

<style>
  .tool-hub {
    display: grid;
    gap: 2.4rem;
    width: min(100%, 88rem);
    margin: 1.5rem auto 3.5rem;
  }
  .tool-hub-group {
    margin: 0;
  }
  .tool-hub-group > header {
    display: grid;
    grid-template-columns: minmax(0, 1fr) minmax(16rem, 0.8fr);
    align-items: end;
    gap: 1rem;
    margin-bottom: 0.85rem;
  }
  .tool-hub-group > header h2 {
    margin: 0;
    color: var(--marker-ink);
    font-size: clamp(1.15rem, 2.4vw, 1.55rem);
  }
  .tool-hub-group > header p {
    margin: 0;
    color: var(--marker-muted);
    font-size: 0.82rem;
    line-height: 1.55;
  }
  .tool-hub-grid {
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    gap: 0.9rem;
  }
  .tool-hub-card {
    position: relative;
    display: flex;
    min-height: 15rem;
    flex-direction: column;
    padding: clamp(1.15rem, 3vw, 1.65rem);
    border: 1px solid var(--marker-border);
    border-radius: 1rem;
    color: var(--marker-ink);
    background: var(--marker-panel);
    text-decoration: none;
    transition: transform 160ms ease, border-color 160ms ease;
  }
  .tool-hub-card:hover {
    border-color: color-mix(in srgb, var(--marker-blue) 60%, var(--marker-border));
    transform: translateY(-3px);
  }
  .tool-hub-index {
    color: var(--marker-coral);
    font-family: var(--sl-font-mono);
    font-size: 0.68rem;
    font-weight: 750;
  }
  .tool-hub-badge {
    position: absolute;
    top: 1rem;
    inset-inline-end: 1rem;
    padding: 0.25rem 0.55rem;
    border-radius: 999px;
    color: var(--marker-muted);
    background: color-mix(in srgb, var(--marker-blue) 10%, transparent);
    font-size: 0.65rem;
    font-weight: 700;
  }
  .tool-hub-card h3 {
    margin: 2.1rem 0 0.55rem;
    color: var(--marker-ink);
    font-size: clamp(1.25rem, 2.5vw, 1.7rem);
    line-height: 1.1;
    letter-spacing: -0.035em;
  }
  .tool-hub-card p {
    margin: 0 0 1.25rem;
    color: var(--marker-muted);
    font-size: 0.84rem;
    line-height: 1.55;
  }
  .tool-hub-card strong {
    margin-top: auto;
    color: var(--marker-blue);
    font-size: 0.76rem;
  }
  .tool-hub-card-featured {
    grid-column: span 2;
    background:
      radial-gradient(circle at 90% 10%, color-mix(in srgb, var(--marker-blue) 24%, transparent), transparent 38%),
      var(--marker-panel);
  }
  @media (max-width: 58rem) {
    .tool-hub-grid { grid-template-columns: repeat(2, minmax(0, 1fr)); }
  }
  @media (max-width: 36rem) {
    .tool-hub-group > header { grid-template-columns: 1fr; }
    .tool-hub-grid { grid-template-columns: 1fr; }
    .tool-hub-card-featured { grid-column: auto; }
    .tool-hub-card { min-height: 13rem; }
  }
  @media (prefers-reduced-motion: reduce) { .tool-hub-card { transition: none; } }
</style>
