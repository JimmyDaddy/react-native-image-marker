{
  "name": "react-native-image-marker-docs",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "dev": "astro dev",
    "check": "astro check",
    "build": "npm run prepack --prefix .. && npm run build --prefix ../packages/web && npm run build:editor --prefix .. && node scripts/copy-web-worker.mjs && astro check && astro build && node scripts/postbuild.mjs && node scripts/check-build.mjs",
    "assemble:versions": "node scripts/assemble-versioned-site.mjs",
    "check:versions": "node scripts/check-versioned-site.mjs",
    "smoke": "node scripts/smoke-playground.mjs && node scripts/smoke-tools.mjs && node scripts/smoke-accessibility.mjs",
    "smoke:accessibility": "node scripts/smoke-accessibility.mjs",
    "generate:v1-7-example": "node scripts/generate-v1-7-example.mjs",
    "preview": "astro preview"
  },
  "devDependencies": {
    "@astrojs/check": "0.9.10",
    "@astrojs/starlight": "0.41.7",
    "@axe-core/playwright": "^4.13.0",
    "@contentauth/c2pa-web": "0.13.4",
    "astro": "7.2.2",
    "fflate": "0.8.3",
    "playwright": "1.62.1",
    "starlight-typedoc": "0.23.1",
    "typedoc": "0.28.20",
    "typedoc-plugin-markdown": "4.12.0",
    "typedoc-plugin-rename-defaults": "0.7.3",
    "typescript": "5.9.3"
  },
  "dependencies": {
    "@image-marker/web": "file:../packages/web"
  },
  "overrides": {
    "ts-deepmerge": "8.0.0"
  }
}
