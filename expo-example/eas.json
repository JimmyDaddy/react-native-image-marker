{
  "cli": {
    "version": ">= 7.1.0"
  },
  "build": {
    "development": {
      "developmentClient": true,
      "distribution": "internal",
      "env": {
        "RCT_NEW_ARCH_ENABLED": "0"
      }
    },
    "development-new-arch": {
      "developmentClient": true,
      "distribution": "internal",
      "env": {
        "RCT_NEW_ARCH_ENABLED": "1",
        "RCT_FABRIC_ENABLED": "1"
      }
    },
    "preview": {
      "distribution": "internal",
      "env": {
        "RCT_NEW_ARCH_ENABLED": "0"
      }
    },
    "preview-new-arch": {
      "distribution": "internal",
      "env": {
        "RCT_NEW_ARCH_ENABLED": "1",
        "RCT_FABRIC_ENABLED": "1"
      }
    },
    "production": {
      "env": {
        "RCT_NEW_ARCH_ENABLED": "0"
      }
    },
    "production-new-arch": {
      "env": {
        "RCT_NEW_ARCH_ENABLED": "1",
        "RCT_FABRIC_ENABLED": "1"
      }
    }
  },
  "submit": {
    "production": {}
  }
}
