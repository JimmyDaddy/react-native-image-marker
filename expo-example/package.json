{
  "name": "expo-example",
  "version": "1.0.0",
  "main": "node_modules/expo/AppEntry.js",
  "scripts": {
    "start": "expo start",
    "android": "expo run:android",
    "ios": "expo run:ios",
    "web": "expo start --web",
    "typecheck": "tsc --noEmit",
    "bundle:smoke": "expo export --platform android --output-dir dist/smoke",
    "bundle:web": "expo export --platform web --output-dir dist/web",
    "verify:web-bundle": "node scripts/verify-web-bundle.mjs",
    "smoke:web": "node scripts/smoke-web.mjs",
    "expo-install": "npx expo install"
  },
  "dependencies": {
    "@expo/metro-runtime": "~3.1.3",
    "@expo/react-native-action-sheet": "^4.0.1",
    "expo": "~50.0.3",
    "expo-asset": "~9.0.2",
    "expo-file-system": "~16.0.5",
    "expo-font": "~11.10.2",
    "expo-image-manipulator": "~11.8.0",
    "expo-image-picker": "~14.7.1",
    "expo-status-bar": "~1.11.1",
    "filesize": "^10.1.0",
    "pako": "^3.0.1",
    "react": "18.2.0",
    "react-dom": "^18.2.0",
    "react-native": "0.73.2",
    "react-native-image-marker": "file:..",
    "react-native-toast-message": "^2.2.0",
    "react-native-web": "^0.19.13"
  },
  "devDependencies": {
    "@babel/core": "^7.20.0",
    "@types/react": "~18.2.45",
    "playwright": "1.61.1",
    "typescript": "^5.1.3"
  },
  "private": true
}
