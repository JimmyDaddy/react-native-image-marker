{
  "name": "expo-example",
  "version": "1.0.0",
  "main": "node_modules/expo/AppEntry.js",
  "scripts": {
    "start": "expo start",
    "android": "expo run:android",
    "ios": "expo run:ios",
    "web": "expo start --web",
    "typecheck": "tsc --noEmit",
    "bundle:smoke": "expo export --platform android --output-dir dist/smoke",
    "bundle:web": "expo export --platform web --output-dir dist/web",
    "verify:web-bundle": "node scripts/verify-web-bundle.mjs",
    "smoke:web": "node scripts/smoke-web.mjs",
    "expo-install": "npx expo install"
  },
  "dependencies": {
    "@expo/metro-runtime": "~57.0.7",
    "expo": "57.0.8",
    "expo-asset": "~57.0.6",
    "expo-font": "~57.0.1",
    "expo-image-picker": "~57.0.6",
    "expo-splash-screen": "~57.0.5",
    "expo-status-bar": "~57.0.1",
    "react": "19.2.3",
    "react-dom": "19.2.8",
    "react-native": "0.86.0",
    "react-native-image-marker": "file:..",
    "react-native-web": "^0.21.2"
  },
  "devDependencies": {
    "@babel/core": "^7.20.0",
    "@types/react": "~19.2.14",
    "playwright": "1.61.1",
    "typescript": "~6.0.3"
  },
  "private": true
}
