{
  "name": "react-native-image-marker-editor",
  "version": "0.1.0",
  "description": "Optional interactive Recipe v2 editor for react-native-image-marker",
  "license": "MIT",
  "homepage": "https://image-marker.corerobin.com/guides/editor/",
  "bugs": {
    "url": "https://github.com/JimmyDaddy/react-native-image-marker/issues"
  },
  "keywords": [
    "react-native",
    "image",
    "watermark",
    "editor",
    "recipe",
    "layers"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/JimmyDaddy/react-native-image-marker.git",
    "directory": "packages/editor"
  },
  "main": "lib/commonjs/index.js",
  "module": "lib/module/index.js",
  "types": "lib/module/index.d.ts",
  "react-native": "src/index.ts",
  "source": "src/index.ts",
  "files": [
    "src",
    "!src/__tests__",
    "api-contract.json",
    "lib",
    "README.md",
    "CHANGELOG.md"
  ],
  "exports": {
    ".": {
      "react-native": "./src/index.ts",
      "import": {
        "types": "./lib/module/index.d.ts",
        "default": "./lib/module/index.js"
      },
      "require": {
        "types": "./lib/module/index.d.ts",
        "default": "./lib/commonjs/index.js"
      }
    },
    "./core-adapter": {
      "react-native": "./src/core-adapter.ts",
      "import": {
        "types": "./lib/module/core-adapter.d.ts",
        "default": "./lib/module/core-adapter.js"
      },
      "require": {
        "types": "./lib/module/core-adapter.d.ts",
        "default": "./lib/commonjs/core-adapter.js"
      }
    },
    "./package.json": "./package.json"
  },
  "scripts": {
    "build": "tsc -p tsconfig.module.json && node ../../scripts/fix-esm-imports.mjs lib/module && tsc -p tsconfig.commonjs.json",
    "check:api": "node ../../scripts/verify-editor-api-contract.mjs",
    "test": "jest --config jest.config.js --runInBand",
    "prepack": "npm run build"
  },
  "peerDependencies": {
    "react": ">=18",
    "react-native": ">=0.73",
    "react-native-image-marker": "^2.0.0"
  },
  "devDependencies": {
    "react-native-image-marker": "file:../.."
  },
  "engines": {
    "node": ">=20.19.0"
  },
  "publishConfig": {
    "registry": "https://registry.npmjs.org/",
    "provenance": true
  },
  "release-it": {
    "git": {
      "commitMessage": "chore(editor): release ${version}",
      "tagName": "editor-v${version}"
    },
    "npm": {
      "publish": false
    },
    "github": {
      "release": true
    }
  }
}
