{
  "name": "@image-marker/web",
  "version": "0.1.0",
  "description": "Standalone browser image watermarks, recipes and headless editing without React Native",
  "license": "MIT",
  "homepage": "https://image-marker.corerobin.com/guides/web-sdk/",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/JimmyDaddy/react-native-image-marker.git",
    "directory": "packages/web"
  },
  "main": "lib/commonjs/index.js",
  "module": "lib/module/index.js",
  "types": "lib/module/index.d.ts",
  "sideEffects": false,
  "files": [
    "lib",
    "api-contract.json",
    "README.md",
    "CHANGELOG.md"
  ],
  "exports": {
    ".": {
      "import": {
        "types": "./lib/module/index.d.ts",
        "default": "./lib/module/index.js"
      },
      "require": {
        "types": "./lib/commonjs/index.d.ts",
        "default": "./lib/commonjs/index.js"
      }
    },
    "./headless": {
      "import": {
        "types": "./lib/module/headless.d.ts",
        "default": "./lib/module/headless.js"
      },
      "require": {
        "types": "./lib/commonjs/headless.d.ts",
        "default": "./lib/commonjs/headless.js"
      }
    },
    "./editor-adapter": {
      "import": {
        "types": "./lib/module/editor-adapter.d.ts",
        "default": "./lib/module/editor-adapter.js"
      },
      "require": {
        "types": "./lib/commonjs/editor-adapter.d.ts",
        "default": "./lib/commonjs/editor-adapter.js"
      }
    },
    "./worker": "./lib/worker/invisible-watermark.js",
    "./worker/invisible-watermark.js": "./lib/worker/invisible-watermark.js",
    "./package.json": "./package.json"
  },
  "scripts": {
    "build": "npm run build:recipe --prefix ../.. && node ../../scripts/build-web-package.mjs",
    "check:api": "node ../../scripts/verify-web-api-contract.mjs",
    "prepack": "npm run build"
  },
  "dependencies": {
    "@image-marker/recipe": "^0.1.0"
  },
  "engines": {
    "node": ">=20.19.0"
  },
  "publishConfig": {
    "access": "public",
    "registry": "https://registry.npmjs.org/",
    "provenance": true
  },
  "release-it": {
    "git": {
      "commitMessage": "chore(web): release ${version}",
      "tagName": "web-v${version}"
    },
    "npm": {
      "publish": false
    },
    "github": {
      "release": true
    }
  }
}
