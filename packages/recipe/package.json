{
  "name": "@image-marker/recipe",
  "version": "0.1.0",
  "description": "Platform-neutral Recipe v2 schema, validation, migration, templates, and layer operations for Image Marker",
  "license": "MIT",
  "homepage": "https://image-marker.corerobin.com/recipe/",
  "bugs": {
    "url": "https://github.com/JimmyDaddy/react-native-image-marker/issues"
  },
  "keywords": [
    "image",
    "watermark",
    "recipe",
    "schema",
    "template",
    "layers"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/JimmyDaddy/react-native-image-marker.git",
    "directory": "packages/recipe"
  },
  "main": "lib/commonjs/index.js",
  "module": "lib/module/index.js",
  "types": "lib/module/index.d.ts",
  "source": "src/index.ts",
  "sideEffects": false,
  "files": [
    "src",
    "!src/__tests__",
    "lib",
    "recipe.schema.json",
    "README.md",
    "CHANGELOG.md"
  ],
  "exports": {
    ".": {
      "import": {
        "types": "./lib/module/index.d.ts",
        "default": "./lib/module/index.js"
      },
      "require": {
        "types": "./lib/module/index.d.ts",
        "default": "./lib/commonjs/index.js"
      }
    },
    "./schema.json": "./recipe.schema.json",
    "./package.json": "./package.json"
  },
  "scripts": {
    "build": "tsc -p tsconfig.module.json && node ../../scripts/fix-esm-imports.mjs lib/module && tsc -p tsconfig.commonjs.json",
    "test": "jest --config jest.config.js --runInBand",
    "prepack": "npm run build"
  },
  "engines": {
    "node": ">=20.19.0"
  },
  "publishConfig": {
    "access": "public",
    "registry": "https://registry.npmjs.org/",
    "provenance": true
  },
  "release-it": {
    "git": {
      "commitMessage": "chore(recipe): release ${version}",
      "tagName": "recipe-v${version}"
    },
    "npm": {
      "publish": false
    },
    "github": {
      "release": true
    }
  }
}
