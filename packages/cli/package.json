{
  "name": "@image-marker/cli",
  "version": "0.1.0",
  "description": "Automation-friendly Image Marker CLI for Recipe v2 and Node rendering",
  "license": "MIT",
  "homepage": "https://image-marker.corerobin.com/cli/",
  "bugs": {
    "url": "https://github.com/JimmyDaddy/react-native-image-marker/issues"
  },
  "keywords": [
    "cli",
    "node",
    "image",
    "watermark",
    "recipe",
    "batch"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/JimmyDaddy/react-native-image-marker.git",
    "directory": "packages/cli"
  },
  "bin": {
    "image-marker": "lib/commonjs/bin.js"
  },
  "main": "lib/commonjs/index.js",
  "module": "lib/module/index.js",
  "types": "lib/module/index.d.ts",
  "source": "src/index.ts",
  "sideEffects": false,
  "files": [
    "src",
    "!src/__tests__",
    "lib",
    "README.md",
    "CHANGELOG.md"
  ],
  "exports": {
    ".": {
      "import": {
        "types": "./lib/module/index.d.ts",
        "default": "./lib/module/index.js"
      },
      "require": {
        "types": "./lib/module/index.d.ts",
        "default": "./lib/commonjs/index.js"
      }
    },
    "./package.json": "./package.json"
  },
  "scripts": {
    "build": "node ../../scripts/generate-package-version.mjs package.json src/version.ts IMAGE_MARKER_CLI_VERSION && tsc -p tsconfig.module.json && node ../../scripts/fix-esm-imports.mjs lib/module && tsc -p tsconfig.commonjs.json && chmod +x lib/commonjs/bin.js",
    "test": "jest --config jest.config.js --runInBand",
    "prepack": "npm run build"
  },
  "dependencies": {
    "@image-marker/node": "^0.1.0",
    "@image-marker/recipe": "^0.1.0",
    "sharp": "^0.35.4"
  },
  "devDependencies": {
    "@types/node": "^22.15.0"
  },
  "engines": {
    "node": ">=20.19.0"
  },
  "publishConfig": {
    "access": "public",
    "registry": "https://registry.npmjs.org/",
    "provenance": true
  },
  "release-it": {
    "git": {
      "commitMessage": "chore(cli): release ${version}",
      "tagName": "cli-v${version}"
    },
    "npm": {
      "publish": false
    },
    "github": {
      "release": true
    }
  }
}
