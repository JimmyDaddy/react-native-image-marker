{
  "name": "@image-marker/node",
  "version": "0.1.0",
  "description": "Pure Node.js Recipe renderer for Image Marker, powered by an optional Sharp peer",
  "license": "MIT",
  "homepage": "https://image-marker.corerobin.com/node/",
  "bugs": {
    "url": "https://github.com/JimmyDaddy/react-native-image-marker/issues"
  },
  "keywords": [
    "node",
    "image",
    "watermark",
    "recipe",
    "sharp",
    "server"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/JimmyDaddy/react-native-image-marker.git",
    "directory": "packages/node"
  },
  "main": "lib/commonjs/index.js",
  "module": "lib/module/index.js",
  "types": "lib/module/index.d.ts",
  "source": "src/index.ts",
  "sideEffects": false,
  "files": [
    "src",
    "!src/__tests__",
    "lib",
    "README.md",
    "CHANGELOG.md"
  ],
  "exports": {
    ".": {
      "import": {
        "types": "./lib/module/index.d.ts",
        "default": "./lib/module/index.js"
      },
      "require": {
        "types": "./lib/module/index.d.ts",
        "default": "./lib/commonjs/index.js"
      }
    },
    "./package.json": "./package.json"
  },
  "scripts": {
    "build": "tsc -p tsconfig.module.json && node ../../scripts/fix-esm-imports.mjs lib/module && tsc -p tsconfig.commonjs.json",
    "test": "jest --config jest.config.js --runInBand",
    "prepack": "npm run build"
  },
  "dependencies": {
    "@image-marker/recipe": "^0.1.0"
  },
  "peerDependencies": {
    "sharp": ">=0.35.0"
  },
  "peerDependenciesMeta": {
    "sharp": {
      "optional": true
    }
  },
  "devDependencies": {
    "@types/node": "^22.15.0",
    "sharp": "^0.35.4"
  },
  "engines": {
    "node": ">=20.19.0"
  },
  "publishConfig": {
    "access": "public",
    "registry": "https://registry.npmjs.org/",
    "provenance": true
  },
  "release-it": {
    "git": {
      "commitMessage": "chore(node): release ${version}",
      "tagName": "node-v${version}"
    },
    "npm": {
      "publish": false
    },
    "github": {
      "release": true
    }
  }
}
