{
  "name": "react-native-image-marker",
  "version": "2.0.0",
  "packageManager": "npm@10.9.4",
  "workspaces": [
    "packages/editor"
  ],
  "description": "Add visible and invisible image watermarks in React Native and React Native Web",
  "main": "lib/commonjs/index",
  "module": "lib/module/index",
  "types": "lib/typescript/module/index.d.ts",
  "react-native": "src/index",
  "source": "src/index",
  "exports": {
    ".": {
      "react-native": "./src/index.ts",
      "import": {
        "types": "./lib/typescript/module/index.d.ts",
        "default": "./lib/module/index.js"
      },
      "require": {
        "types": "./lib/typescript/commonjs/index.d.ts",
        "default": "./lib/commonjs/index.js"
      }
    },
    "./web": {
      "import": {
        "types": "./lib/typescript/module/web/index.d.ts",
        "default": "./lib/module/web/index.js"
      },
      "require": {
        "types": "./lib/typescript/commonjs/web/index.d.ts",
        "default": "./lib/commonjs/web/index.js"
      }
    },
    "./trace-runtime": {
      "types": "./trace-runtime.d.ts",
      "import": "./trace-runtime.js",
      "require": "./trace-runtime.js"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "src",
    "lib",
    "android",
    "ios",
    "cpp",
    "app.plugin.js",
    "trace-runtime.js",
    "trace-runtime.d.ts",
    "*.podspec",
    "!lib/typescript/example",
    "!ios/build",
    "!android/build",
    "!android/gradle",
    "!android/gradlew",
    "!android/gradlew.bat",
    "!android/local.properties",
    "!cpp/tests",
    "!**/__tests__",
    "!**/__fixtures__",
    "!**/__mocks__",
    "!**/.*"
  ],
  "scripts": {
    "test": "jest",
    "test:release-routing": "node --test scripts/__tests__/release-target.test.mjs",
    "test:web": "jest src/__tests__/web-marker.test.ts src/__tests__/web-marker-api.test.ts src/__tests__/web-marker-render.test.ts src/__tests__/invisible-worker-client.test.ts --runInBand",
    "test:editor": "npm test --workspace react-native-image-marker-editor",
    "test:cpp": "c++ -std=c++17 -Wall -Wextra -Werror cpp/tests/ImageMarkerCoreTest.cpp -o /tmp/image-marker-core-test && /tmp/image-marker-core-test",
    "test:cpp:ios-bridge": "xcrun clang++ -std=c++17 -Wall -Wextra -Werror -c ios/RCTImageMarker/ImageMarkerCoreBridge.mm -o /tmp/image-marker-core-bridge.o && xcrun swiftc -import-objc-header ios/RCTImageMarker/ImageMarkerCoreBridge.h cpp/tests/ImageMarkerCoreBridgeSmoke.swift /tmp/image-marker-core-bridge.o -lc++ -o /tmp/image-marker-core-bridge-test && /tmp/image-marker-core-bridge-test",
    "typecheck": "tsc --noEmit && npm run typecheck:api",
    "typecheck:api": "tsc --noEmit --strict --skipLibCheck --esModuleInterop --verbatimModuleSyntax --moduleResolution node --module esnext --target esnext src/__tests__/image-mark-options.typecheck.ts src/__tests__/trace-runtime.typecheck.ts",
    "typecheck:example": "npm --prefix example run typecheck",
    "typecheck:expo-example": "npm --prefix expo-example run typecheck",
    "lint": "eslint \"**/*.{js,ts,tsx}\"",
    "build:worker": "node scripts/build-invisible-worker.mjs",
    "prepack": "bob build && node scripts/fix-esm-imports.mjs lib/module lib/typescript/module && npm run build:worker",
    "build:editor": "npm run build --workspace react-native-image-marker-editor",
    "verify:consumer": "npm run prepack && npm run build:editor && node scripts/verify-package-consumer.mjs",
    "check:release-notes": "node scripts/check-release-notes.mjs",
    "release": "release-it",
    "example": "yarn --cwd example",
    "expo-example": "yarn --cwd expo-example",
    "bootstrap": "yarn example && yarn install && yarn example pods && yarn expo-example && yarn expo-example expo-install",
    "bootstrap-m1": "yarn example && yarn install && yarn example m1-pods",
    "clean": "del-cli android/build example/android/build example/android/app/build example/ios/build",
    "docs": "npm --prefix website run build",
    "verify:release-target": "node scripts/verify-release-target.mjs",
    "docs:dev": "npm --prefix website run dev",
    "expo-install": "yarn expo-example expo-install"
  },
  "keywords": [
    "react-native",
    "react-native-web",
    "web",
    "canvas",
    "ios",
    "android",
    "image",
    "marker",
    "text",
    "watermark",
    "invisible-watermark",
    "image-tracing",
    "icon"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/JimmyDaddy/react-native-image-marker.git"
  },
  "author": "jimmydaddy <heyjimmygo@gmail.com> (https://github.com/JimmyDaddy)",
  "license": "MIT",
  "bugs": {
    "url": "https://github.com/JimmyDaddy/react-native-image-marker/issues"
  },
  "homepage": "https://image-marker.corerobin.com",
  "publishConfig": {
    "registry": "https://registry.npmjs.org/",
    "provenance": true
  },
  "devDependencies": {
    "@commitlint/config-conventional": "^21.2.0",
    "@evilmartians/lefthook": "^2.1.10",
    "@expo/config-plugins": "^57.0.5",
    "@react-native-community/eslint-config": "^3.0.2",
    "@release-it/conventional-changelog": "^11.0.1",
    "@types/jest": "^28.1.2",
    "@types/react": "~18.2.45",
    "@types/react-native": "0.70.0",
    "commitlint": "^21.2.1",
    "conventional-changelog-conventionalcommits": "10.2.1",
    "del-cli": "^5.0.0",
    "esbuild": "^0.28.1",
    "eslint": "^8.4.1",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-prettier": "^4.0.0",
    "husky": "^8.0.3",
    "jest": "^28.1.1",
    "metro-react-native-babel-preset": "^0.77.0",
    "patch-package": "^8.0.0",
    "pod-install": "^1.1.0",
    "postinstall-postinstall": "^2.1.0",
    "prettier": "^2.0.5",
    "react": "18.2.0",
    "react-native": "0.73.3",
    "react-native-builder-bob": "^0.43.0",
    "release-it": "^20.2.1",
    "typescript": "^5.9.3"
  },
  "resolutions": {
    "@types/react": "18.2.79"
  },
  "peerDependencies": {
    "react": ">=18",
    "react-native": ">=0.73"
  },
  "engines": {
    "node": ">=20.19.0"
  },
  "jest": {
    "preset": "react-native",
    "testPathIgnorePatterns": [
      "/node_modules/",
      "<rootDir>/packages/editor/",
      "<rootDir>/src/__tests__/.*\\.typecheck\\.ts$"
    ],
    "modulePathIgnorePatterns": [
      "<rootDir>/example/node_modules",
      "<rootDir>/lib/"
    ],
    "coverageThreshold": {
      "./src/web/": {
        "branches": 65,
        "lines": 75
      }
    }
  },
  "commitlint": {
    "extends": [
      "@commitlint/config-conventional"
    ]
  },
  "release-it": {
    "git": {
      "commitMessage": "chore: release ${version}",
      "tagName": "v${version}"
    },
    "npm": {
      "publish": false
    },
    "github": {
      "release": true
    },
    "plugins": {
      "@release-it/conventional-changelog": {
        "preset": "conventionalcommits",
        "infile": "CHANGELOG.md",
        "header": "# Changelog",
        "releaseCount": 0
      }
    }
  },
  "overrides": {
    "uuid": "11.1.1"
  },
  "eslintConfig": {
    "root": true,
    "extends": [
      "@react-native-community",
      "prettier"
    ],
    "rules": {
      "prettier/prettier": [
        "error",
        {
          "quoteProps": "consistent",
          "singleQuote": true,
          "tabWidth": 2,
          "trailingComma": "es5",
          "useTabs": false
        }
      ]
    }
  },
  "eslintIgnore": [
    "node_modules/",
    "lib/",
    "coverage/"
  ],
  "prettier": {
    "quoteProps": "consistent",
    "singleQuote": true,
    "tabWidth": 2,
    "trailingComma": "es5",
    "useTabs": false
  },
  "react-native-builder-bob": {
    "source": "src",
    "output": "lib",
    "targets": [
      [
        "commonjs",
        {
          "esm": true
        }
      ],
      [
        "module",
        {
          "esm": true
        }
      ],
      [
        "typescript",
        {
          "project": "tsconfig.build.json"
        }
      ]
    ]
  },
  "codegenConfig": {
    "name": "RNImageMarkerSpec",
    "type": "modules",
    "jsSrcsDir": "src",
    "android": {
      "javaPackageName": "com.jimmydaddy.imagemarker"
    },
    "ios": {
      "moduleName": "ImageMarker"
    }
  }
}
